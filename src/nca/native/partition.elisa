# Incremental selected/alternative path partitions for weighted automata.
# Every table row describes the prefixes before the corresponding input row.
extern exp(x: f64) -> f64
extern log(x: f64) -> f64
extern log1p(x: f64) -> f64

def add_logs(x: f64, y: f64) -> f64:
    return y if x == log(0.0)
    return x if y == log(0.0)
    larger: f64 = x if x >= y else y
    smaller: f64 = y if x >= y else x
    correction: f64 = log1p(exp(smaller - larger))
    result: f64 = larger + correction
    # Below 2^26, binary64 round-to-nearest error is less than 2^-27.
    return result if result > -67108864.0 and result < 67108864.0
    roundoff: f64 = (result - larger) - correction
    return log(-1.0) if roundoff >= 1.01e-8 or roundoff <= -1.01e-8
    return result

def multiply_logs(x: f64, y: f64) -> f64:
    result: f64 = x + y
    return log(-1.0) if result == log(0.0) or result == -log(0.0) or result != result
    return result if result > -67108864.0 and result < 67108864.0
    virtual: f64 = result - x
    residual: f64 = (x - (result - virtual)) + (y - virtual)
    return log(-1.0) if residual != residual or residual >= 1.01e-8 or residual <= -1.01e-8
    return result

# Find the earliest changed input row without allocating a comparison array.
def first_change(rows: view[f64], old_rows: view[f64], selected: view[i64], old_selected: view[i64], width: i64) -> i64:
    for k in 0..<selected.len.i64():
        return k if selected[k] != old_selected[k]
        for j in 0..<width:
            return k if rows[k * width + j] != old_rows[k * width + j]
    return selected.len.i64()

# Mutates rows after `start`; the caller must supply a valid prefix at `start`.
# Empty output signals arithmetic failure; otherwise returns selected and other log mass.
def update(log_probs: view[f64], alphabet: view[i64], transitions: view[i64], prior: view[f64], final: view[f64], selected: view[i64], alternatives: mutable view[f64], bounds: mutable view[i64], matched_states: mutable view[i64], matched_weights: mutable view[f64], start: i64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    states: i64 = final.len.i64()
    m: i64 = selected.len.i64()
    unreachable: f64 = log(0.0)
    active: mutable darray[i64] = [0 for _ in 0..<width]
    indexed: bool =
        if width >= 16 and m - start >= 16:
            for j in 0..<width |valid: bool = true| -> valid:
                if alphabet[j] != j:
                    valid <- false
                    break
        else:
            false
    for k in start..<m:
        if matched_weights[k] == unreachable and bounds[k * 2] > bounds[k * 2 + 1]:
            # Every later prefix is empty; clear old suffix envelopes so a
            # later update may safely reuse any of them.
            for row in (k + 1)..<(m + 1):
                for state in bounds[row * 2]..<(bounds[row * 2 + 1] + 1):
                    alternatives[row * states + state] <- unreachable
                bounds[row * 2] <- states
                bounds[row * 2 + 1] <- -1
                matched_states[row] <- matched_states[k]
                matched_weights[row] <- unreachable
            return [unreachable, unreachable]
        here: i64 = k * states
        next: i64 = (k + 1) * states
        # Cells outside the previous destination envelope are already unreachable.
        for state in bounds[(k + 1) * 2]..<(bounds[(k + 1) * 2 + 1] + 1):
            alternatives[next + state] <- unreachable
        match_state: i64 = matched_states[k]
        match_weight: f64 = matched_weights[k]
        low: i64 = match_state if match_weight != unreachable and match_state < bounds[k * 2] else bounds[k * 2]
        high: i64 = match_state if match_weight != unreachable and match_state > bounds[k * 2 + 1] else bounds[k * 2 + 1]
        bounds[(k + 1) * 2] <- states
        bounds[(k + 1) * 2 + 1] <- -1
        # Sampling selects an optimization only; every column remains eligible.
        filtered: bool = width >= 16 and high > low and (log_probs[k * width + width / 2] == unreachable or log_probs[k * width + width - 1] == unreachable)
        active_count, found_column =
            if filtered:
                for j in 0..<width |count: i64 = 0, column: i64 = -1, active| -> (count, column):
                    if not indexed and match_weight != unreachable and column < 0 and alphabet[j] == selected[k]:
                        column <- j
                    if log_probs[k * width + j] != unreachable:
                        active[count] <- j
                        count += 1
            else:
                (width, -1)
        for state in low..<(high + 1):
            source: f64 = alternatives[here + state]
            same: bool = state == match_state and match_weight != unreachable
            continue if source == unreachable and not same
            for index in 0..<active_count:
                j: i64 = active[index] if filtered else index
                edge: i64 = state * width + j
                target: i64 = transitions[edge]
                continue if target < 0
                reading: f64 = log_probs[k * width + j]
                edge_weight: f64 = prior[edge]
                continue if reading == unreachable or edge_weight == unreachable
                continue if source == unreachable and (not same or alphabet[j] == selected[k])
                weight: f64 = multiply_logs(reading, edge_weight)
                return [] if weight != weight
                if source != unreachable:
                    through: f64 = multiply_logs(source, weight)
                    return [] if through != through
                    combined: f64 = add_logs(alternatives[next + target], through)
                    return [] if combined != combined
                    alternatives[next + target] <- combined
                if same and alphabet[j] != selected[k]:
                    through: f64 = multiply_logs(match_weight, weight)
                    return [] if through != through
                    combined: f64 = add_logs(alternatives[next + target], through)
                    return [] if combined != combined
                    alternatives[next + target] <- combined
                bounds[(k + 1) * 2] <- target if target < bounds[(k + 1) * 2] else bounds[(k + 1) * 2]
                bounds[(k + 1) * 2 + 1] <- target if target > bounds[(k + 1) * 2 + 1] else bounds[(k + 1) * 2 + 1]
        matched_states[k + 1] <- match_state
        matched_weights[k + 1] <- unreachable
        if match_weight != unreachable:
            chosen: i64 =
                if indexed:
                    selected[k] if selected[k] >= 0 and selected[k] < width else -1
                elif filtered:
                    found_column
                else:
                    for j in 0..<width |found: i64 = -1| -> found:
                        if alphabet[j] == selected[k]:
                            found <- j
                            break
            if chosen >= 0:
                edge: i64 = match_state * width + chosen
                target: i64 = transitions[edge]
                reading: f64 = log_probs[k * width + chosen]
                edge_weight: f64 = prior[edge]
                if target >= 0 and reading != unreachable and edge_weight != unreachable:
                    weight: f64 = multiply_logs(reading, edge_weight)
                    return [] if weight != weight
                    value: f64 = multiply_logs(match_weight, weight)
                    return [] if value != value
                    matched_states[k + 1] <- target
                    matched_weights[k + 1] <- value
    match_state: i64 = matched_states[m]
    match_weight: f64 = matched_weights[m]
    chosen: f64 =
        if match_weight == unreachable or final[match_state] == unreachable:
            unreachable
        else:
            value: f64 = multiply_logs(match_weight, final[match_state])
            return [] if value != value
            value
    other: f64 =
        for state in bounds[m * 2]..<(bounds[m * 2 + 1] + 1) |total: f64 = unreachable| -> total:
            prefix: f64 = alternatives[m * states + state]
            continue if prefix == unreachable or final[state] == unreachable
            value: f64 = multiply_logs(prefix, final[state])
            return [] if value != value
            combined: f64 = add_logs(total, value)
            return [] if combined != combined
            total <- combined
    return [chosen, other]

export pymodule partition:
    fn update
    fn first_change
