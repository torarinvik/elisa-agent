# Distribution of a sum of independent Bernoulli variables.
# Descending updates preserve the preceding row in place.
extern nextafter(x: f64, y: f64) -> f64
extern log(x: f64) -> f64

def upper_product(a: f64, b: f64) -> f64:
    return 0.0 if a == 0.0 or b == 0.0
    product: f64 = a * b
    return 1.0 if product >= 1.0
    return nextafter(product, 1.0)

def upper_add(a: f64, b: f64) -> f64:
    return b if a == 0.0
    return a if b == 0.0
    total: f64 = a + b
    return 1.0 if total >= 1.0
    return nextafter(total, 1.0)

def upper_power(base: f64, n: i64) -> f64:
    return
        for _ in 0..<63 |value: f64 = 1.0, factor: f64 = base, remaining: i64 = n| -> value:
            break if remaining == 0
            value <- upper_product(value, factor) if remaining % 2 == 1 else value
            remaining <- remaining / 2
            factor <- upper_product(factor, factor) if remaining > 0 else factor

# Upper bisection endpoint for the zero-error Clopper–Pearson limit.
def clopper_zero_upper(n: i64, alpha: f64) -> f64:
    return 1.0 if n <= 0
    return
        for _ in 0..<60 |low: f64 = 0.0, high: f64 = 1.0| -> high:
            mid: f64 = (low + high) / 2.0
            cdf: f64 = 0.0 if mid >= 1.0 else upper_power(nextafter(1.0 - mid, 1.0), n)
            if cdf >= alpha:
                low <- mid
            else:
                high <- mid

# Upper bound on min(1, sum of unordered products) without subtraction.
def pair_risk_upper(risks: view[f64]) -> f64:
    total: f64 =
        for i in 0..<risks.len.i64() |total: f64 = 0.0, prefix: f64 = 0.0| -> total:
            value: f64 = risks[i]
            total <- upper_add(total, upper_product(prefix, value))
            sum: f64 = prefix + value
            if prefix == 0.0 or value == 0.0 or sum == -log(0.0):
                prefix <- sum
            else:
                prefix <- nextafter(sum, -log(0.0))
    return total

def fixed_event(p: f64, q: f64) -> bool:
    return (p == 0.0 and q == 1.0) or (p == 1.0 and q == 0.0)

# Track the tail directly while retaining only counts below the threshold.
def upper_success_tail(probabilities: view[f64], complements: view[f64], threshold: i64) -> f64 can[Memory.Allocate, Abort.Panic]:
    result: f64 =
        for i in 0..<probabilities.len.i64() |pmf: darray[f64] = [1.0 if j == 0 else 0.0 for j in 0..<threshold], result: f64 = 0.0, active: i64 = 0| -> result:
            p: f64 = probabilities[i]
            q: f64 = complements[i]
            continue if fixed_event(p, q)
            active <- active + 1
            result <- upper_add(result, upper_product(p, pmf[threshold - 1]))
            high: i64 = active if active < threshold else threshold - 1
            for step in 0..<high:
                k: i64 = high - step
                pmf[k] <- upper_add(upper_product(q, pmf[k]), upper_product(p, pmf[k - 1]))
            pmf[0] <- upper_product(q, pmf[0])
    return result

# Upper bound on P(successes >= observed), using a short count range.
def poisson_binomial_upper(probabilities: view[f64], complements: view[f64], observed: i64) -> f64 can[Memory.Allocate, Abort.Panic]:
    n: i64 = probabilities.len.i64()
    return 1.0 if complements.len.i64() != n or observed <= 0
    return 0.0 if observed > n
    certain, active =
        for i in 0..<n |certain: i64 = 0, active: i64 = 0| -> (certain, active):
            p: f64 = probabilities[i]
            q: f64 = complements[i]
            certain <- certain + 1 if p == 1.0 and q == 0.0 else certain
            active <- active + 1 if not fixed_event(p, q) else active
    threshold: i64 = observed - certain
    return 1.0 if threshold <= 0
    return 0.0 if threshold > active
    width: i64 = active - threshold
    return upper_success_tail(probabilities, complements, threshold) if threshold < width
    pmf: darray[f64] =
        for i in 0..<n |pmf: darray[f64] = [1.0 if j == 0 else 0.0 for j in 0..<(width + 1)], active: i64 = 0| -> pmf:
            p: f64 = probabilities[i]
            q: f64 = complements[i]
            continue if fixed_event(p, q)
            active <- active + 1
            high: i64 = active if active < width else width
            for step in 0..<high:
                k: i64 = high - step
                pmf[k] <- upper_add(upper_product(p, pmf[k]), upper_product(q, pmf[k - 1]))
            pmf[0] <- upper_product(p, pmf[0])
    return
        for i in 0..<(width + 1) |total: f64 = 0.0| -> total:
            total <- upper_add(total, pmf[i])

def poisson_binomial_pmf(probabilities: view[f64], complements: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    n: i64 = probabilities.len.i64()
    return [] if complements.len.i64() != n
    bounded: bool =
        for i in 0..<n |valid: bool = true| -> valid:
            p: f64 = probabilities[i]
            q: f64 = complements[i]
            valid <- valid and p >= 0.0 and p <= 1.0 and q >= 0.0 and q <= 1.0
    pmf, certain =
        for i in 0..<n |pmf: darray[f64] = [1.0 if j == 0 else 0.0 for j in 0..<(n + 1)], active: i64 = 0, certain: i64 = 0| -> (pmf, certain):
            p: f64 = probabilities[i]
            q: f64 = complements[i]
            continue if bounded and p == 0.0 and q == 1.0
            if bounded and p == 1.0 and q == 0.0:
                certain <- certain + 1
                continue
            active <- active + 1
            for j in 0..<active:
                k: i64 = active - j
                pmf[k] <- pmf[k] * q + pmf[k - 1] * p
            pmf[0] <- pmf[0] * q
    # Shift once for all certain events, descending to preserve the source.
    return pmf if certain == 0
    for j in 0..<(n + 1):
        k: i64 = n - j
        pmf[k] <- 0.0 if k < certain else pmf[k - certain]
    return pmf

export pymodule stats:
    fn poisson_binomial_pmf
    fn poisson_binomial_upper
    fn pair_risk_upper
    fn clopper_zero_upper
