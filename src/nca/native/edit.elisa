# Optimal-string-alignment distance on Unicode code points (§18.1).
# Three cyclic rows suffice: a transposition reads two rows back.
def edit_distance(a: view[i64], b: view[i64]) -> i64 can[Memory.Allocate, Abort.Panic]:
    return b.len.i64() if a.len == 0
    return a.len.i64() if b.len == 0
    return edit_rows(b, a) if b.len > a.len else edit_rows(a, b)

def edit_rows(a: view[i64], b: view[i64]) -> i64 can[Memory.Allocate, Abort.Panic]:
    m: i64 = a.len.i64()
    n: i64 = b.len.i64()
    width: i64 = n + 1
    rows: darray[i64] =
        for i in 1..<(m + 1) |rows: darray[i64] = [j if j <= n else 0 for j in 0..<(3 * width)]| -> rows:
            here: i64 = (i % 3) * width
            above: i64 = ((i - 1) % 3) * width
            rows[here] <- i
            for j in 1..<(n + 1) |rows|:
                deleted: i64 = rows[above + j] + 1
                inserted: i64 = rows[here + j - 1] + 1
                aligned: i64 = rows[above + j - 1] + (0 if a[i - 1] == b[j - 1] else 1)
                ordinary: i64 = deleted if deleted < inserted else inserted
                best: i64 = ordinary if ordinary < aligned else aligned
                if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                    swapped: i64 = rows[((i - 2) % 3) * width + j - 2] + 1
                    rows[here + j] <- swapped if swapped < best else best
                else:
                    rows[here + j] <- best
    return rows[(m % 3) * width + n]

# One borrowed target slice per word; avoid repeated Python calls and encodings.
def edit_distances(word: view[i64], vocabulary: view[i64], offsets: view[i64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    return [edit_distance(word, vocabulary[offsets[k].usize():offsets[k + 1].usize()]) for k in 0..<(offsets.len.i64() - 1)]

export pymodule edit:
    fn edit_distance
    fn edit_distances
