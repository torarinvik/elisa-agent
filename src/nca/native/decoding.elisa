# Decoding of prefix-formula arity sequences by the counter automaton (THEORY §21).
#
# The state is the number of subformulas still awaited, starting at 1; a word of arity a
# read while n >= 1 are awaited leaves n - 1 + a, and a sequence is accepted when none
# remain at its end. For maximum arity A, before word k the counter is at most
# 1 + k * max(A - 1, 0), and it must be at most m - k to be completable.
#
# The sums run in linear space. Forward row k is stored unscaled and read divided by its
# total c(k), so every step works on a row of total 1 and log Z = Σ log c(k). The backward
# rows are divided by the same totals, so a marginal is
# F(k, n) / c(k) · q(k, a) · B(k + 1, n - 1 + a) / c(k + 1). The most probable sequence is
# found in log space, where it needs only additions.

extern exp(x: f64) -> f64
extern log(x: f64) -> f64
extern log1p(x: f64) -> f64
extern lgamma(x: f64) -> f64
extern nextafter(x: f64, y: f64) -> f64

# Validate nonnegative finite weights and produce their floored logarithms.
# An empty result signals an invalid vector (including an all-zero vector).
def observation_logs(values: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    positive: bool =
        for i in 0..<values.len.i64() |positive: bool = false| -> positive:
            x: f64 = values[i]
            return [] if x != x or x < 0.0 or x == -log(0.0)
            positive <- true if x > 0.0 else positive
    return [] if not positive
    return [log(values[i] if values[i] > 0.0 else nextafter(0.0, 1.0)) for i in 0..<values.len.i64()]

# Sum finite nonnegative binary64 values, rounding each inexact addition up.
def upper_add(total: f64, x: f64) -> f64:
    rounded: f64 = total + x
    part: f64 = rounded - total
    residual: f64 = (total - (rounded - part)) + (x - part)
    return nextafter(rounded, -log(0.0)) if residual > 0.0 else rounded

def upper_sum(values: view[f64]) -> f64 can[Abort.Panic]:
    return
        for i in 0..<values.len.i64() |total: f64 = 0.0| -> total:
            total <- upper_add(total, values[i])

# Sum finite nonnegative binary64 values with downward rounding.
def lower_add(total: f64, x: f64) -> f64:
    rounded: f64 = total + x
    part: f64 = rounded - total
    residual: f64 = (total - (rounded - part)) + (x - part)
    return nextafter(rounded, 0.0) if residual < 0.0 or rounded == -log(0.0) else rounded

def lower_sum(values: view[f64]) -> f64 can[Abort.Panic]:
    return
        for i in 0..<values.len.i64() |total: f64 = 0.0| -> total:
            total <- lower_add(total, values[i])

def lower_product(a: f64, b: f64) -> f64:
    product: f64 = a * b
    return nextafter(product, 0.0) if product > 0.0 else 0.0

def lower_half(x: f64) -> f64:
    half: f64 = x * 0.5
    return nextafter(half, 0.0) if half + half > x else half

# Lower bounds for half the sum and the sum of unordered pair products.
def detection_floors(risks: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    state: darray[f64] = [0.0, 0.0]
    for i in 0..<risks.len.i64():
        state[1] <- lower_add(state[1], lower_product(state[0], risks[i]))
        state[0] <- lower_add(state[0], risks[i])
    return [lower_half(state[0]), state[1]]

# Upper-bounding products of nonnegative binary64 operands.
def upper_product(a: f64, b: f64) -> f64:
    product: f64 = a * b
    return product if a == 0.0 or b == 0.0 or product == -log(0.0)
    return nextafter(product, -log(0.0))

def upper_half(x: f64) -> f64:
    half: f64 = x * 0.5
    return nextafter(half, -log(0.0)) if half + half < x else half

def markov_shares(risks: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return [upper_half(risks[i]) for i in 0..<risks.len.i64()]

def combine_shares(shares: view[f64], within: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return [upper_add(shares[i], within[i]) for i in 0..<shares.len.i64()]

# Half of each item's risk times the sum of all other risks, without subtraction.
def pair_shares(risks: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    n: i64 = risks.len.i64()
    prefix: darray[f64] = [0.0 for _ in 0..<(n + 1)]
    suffix: darray[f64] = [0.0 for _ in 0..<(n + 1)]
    for i in 0..<n:
        prefix[i + 1] <- upper_add(prefix[i], risks[i])
        suffix[n - i - 1] <- upper_add(suffix[n - i], risks[n - i - 1])
    return [upper_product(upper_product(risks[i], upper_add(prefix[i], suffix[i + 1])), 0.5) for i in 0..<n]

# Log weights may contain negative infinity but not NaN or positive infinity.
def valid_log_weights(rows: view[f64]) -> bool can[Abort.Panic]:
    for i in 0..<rows.len.i64():
        x: f64 = rows[i]
        return false if x != x or x == -log(0.0)
    return true

# Accept only rows comfortably inside the normalization tolerance. A false
# result asks the caller to run its full validator, including boundary cases.
def normalized_rows_fast(rows: view[f64], base: view[f64]) -> bool can[Abort.Panic]:
    width: i64 = base.len.i64()
    return false if width < 1 or width > 3 or rows.len.i64() % width != 0
    for k in 0..<(rows.len.i64() / width):
        total: f64 =
            for j in 0..<width |total: f64 = 0.0| -> total:
                x: f64 = rows[k * width + j]
                return false if x != x or x > 0.0 or (base[j] == log(0.0) and x != log(0.0))
                total += exp(x)
        return false if total < 1.0 - 9.0e-13 or total > 1.0 + 9.0e-13
    return true

# The log-weight of an unreachable state, and log Z when no sequence is accepted.
const FLOOR: f64 = -1.0e308

def live(k: i64, m: i64, max_arity: i64) -> i64:
    remaining: i64 = m - k
    return 0 if remaining == 0
    return 1 if k == 0 or max_arity <= 1
    growth: i64 = max_arity - 1
    return remaining if growth > (remaining - 1) / k
    return 1 + k * growth

# Detect invalid posterior rows without claiming a floating-point error bound.
def posterior_rows_valid(rows: view[f64], width: i64, tolerance: f64) -> bool can[Abort.Panic]:
    return false if width < 1 or rows.len.i64() % width != 0
    for k in 0..<(rows.len.i64() / width):
        total: f64 =
            for j in 0..<width |total: f64 = 0.0| -> total:
                value: f64 = rows[k * width + j]
                return false if value != value or value < 0.0 or value > 1.0 + tolerance
                total += value
        return false if total < 1.0 - tolerance or total > 1.0 + tolerance
    return true

# `log_probs` holds m rows of one log-probability per entry of `alphabet` (the arities).
# The result is [log Z, decoded arities (m), posterior marginals (m rows)], or [FLOOR] when
# no parseable sequence has positive weight.
def decode(log_probs: view[f64], alphabet: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    return [FLOOR] if width == 0 or log_probs.len.i64() % width != 0
    m: i64 = log_probs.len.i64() / width
    return [FLOOR] if m == 0
    for j in 0..<width:
        return [FLOOR] if alphabet[j] < 0
    max_arity: i64 =
        for j in 0..<width |largest: i64 = 0| -> largest:
            largest <- alphabet[j] if alphabet[j] > largest and alphabet[j] < m else largest
    row_size: i64 = m + 1
    offsets: darray[i64] =
        for k in 0..<(m + 1) |offsets: darray[i64] = [0 for _ in 0..<(m + 2)]| -> offsets:
            offsets[k + 1] <- offsets[k] + live(k, m, max_arity) + 1
    # Subnormal weights lose relative precision, and finite weights may vanish.
    # Signal the caller to rerun the whole calculation in log space.
    weights: darray[f64] = [0.0 for _ in 0..<(m * width)]
    for k in 0..<m:
        for j in 0..<width:
            continue if alphabet[j] >= m - k
            i: i64 = k * width + j
            weight: f64 = exp(log_probs[i])
            return [FLOOR] if log_probs[i] != log(0.0) and weight < 2.2250738585072014e-308
            return [FLOOR] if weight == -log(0.0)
            weights[i] <- weight
    forward, best, choice, totals, log_z =
        for k in 0..<m |forward: darray[f64] = [1.0 if i == offsets[0] + 1 else 0.0 for i in 0..<offsets[m + 1]], best: darray[f64] = [0.0 if i == 1 else FLOOR for i in 0..<(2 * row_size)], choice: darray[i64] = [0 for _ in 0..<offsets[m + 1]], totals: darray[f64] = [1.0 for _ in 0..<(m + 1)], log_z: f64 = 0.0| -> (forward, best, choice, totals, log_z):
            best_here: i64 = (k % 2) * row_size
            best_next: i64 = ((k + 1) % 2) * row_size
            best[best_here] <- FLOOR
            total: f64 = |forward, best, choice|
                next_row: i64 = offsets[k + 1]
                next_top: i64 = live(k + 1, m, max_arity)
                for n in 1..<(live(k, m, max_arity) + 1) |forward, best, choice|:
                    here_best: f64 = best[best_here + n]
                    # The consumed row becomes the empty destination two steps later.
                    best[best_here + n] <- FLOOR
                    continue if here_best <= FLOOR
                    here: f64 = forward[offsets[k] + n] / totals[k]
                    for j in 0..<width |forward, best, choice|:
                        continue if alphabet[j] > next_top
                        target: i64 = n - 1 + alphabet[j]
                        continue if target > next_top or (target == 0 and k + 1 < m)
                        cell: i64 = next_row + target
                        weight: f64 = weights[k * width + j]
                        contribution: f64 = here * weight
                        return [FLOOR] if here > 0.0 and weight > 0.0 and contribution < 2.2250738585072014e-308
                        forward[cell] <- forward[cell] + contribution
                        candidate: f64 = here_best + log_probs[k * width + j]
                        choice[cell] <- j if candidate > best[best_next + target] or (candidate == best[best_next + target] and j < choice[cell]) else choice[cell]
                        best[best_next + target] <- candidate if candidate > best[best_next + target] else best[best_next + target]
                for n in 0..<(next_top + 1) |total: f64 = 0.0| -> total:
                    total += forward[next_row + n]
            totals[k + 1] <- 1.0 if total <= 0.0 else total
            log_z <- FLOOR if total <= 0.0 or log_z <= FLOOR else log_z + log(total)
    return [FLOOR] if log_z <= FLOOR or best[(m % 2) * row_size] <= FLOOR
    decoded: darray[f64] =
        for step in 0..<m |decoded: darray[f64] = [log_z if i == 0 else 0.0 for i in 0..<(1 + m + m * width)], state: i64 = 0| -> decoded:
            arity: i64 = alphabet[choice[offsets[m - step] + state]]
            decoded[m - step] <- arity.f64()
            state <- state + 1 - arity
    result: darray[f64] =
        for step in 0..<m |result: darray[f64] = decoded, backward: darray[f64] = [1.0 if i == (m % 2) * row_size else 0.0 for i in 0..<(2 * row_size)]| -> result:
            k: i64 = m - 1 - step
            here_row: i64 = offsets[k]
            backward_here: i64 = (k % 2) * row_size
            backward_next: i64 = ((k + 1) % 2) * row_size
            next_top: i64 = live(k + 1, m, max_arity)
            for n in 0..<(live(k, m, max_arity) + 1) |backward|:
                backward[backward_here + n] <- 0.0
            for j in 0..<width |result, backward|:
                continue if alphabet[j] > next_top
                through_total: f64 = |backward|
                    weight: f64 = weights[k * width + j] / totals[k + 1]
                    return [FLOOR] if weight == -log(0.0)
                    for n in 1..<(live(k, m, max_arity) + 1) |backward, through_total: f64 = 0.0| -> through_total:
                        continue if forward[here_row + n] == 0.0
                        through: f64 =
                            target: i64 = n - 1 + alphabet[j]
                            continue if target > next_top or (target == 0 and k + 1 < m)
                            weight * backward[backward_next + target]
                        return [FLOOR] if through == -log(0.0) or through != through
                        backward[backward_here + n] <- backward[backward_here + n] + through
                        return [FLOOR] if backward[backward_here + n] == -log(0.0)
                        through_total += forward[here_row + n] * through
                result[1 + m + k * width + j] <- through_total / totals[k]
    return result

# Product of prior edge and final weights, in log space (NCA.prior, §27).
def prior_log_weight(alphabet: view[i64], transitions: view[i64], weights: view[f64], final: view[f64], start: i64, selected: view[i64]) -> f64 can[Abort.Panic]:
    width: i64 = alphabet.len.i64()
    state, total, failed =
        for k in 0..<selected.len.i64() |state: i64 = start, total: f64 = 0.0, failed: bool = false| -> (state, total, failed):
            column: i64 =
                for j in 0..<width |found: i64 = -1| -> found:
                    if alphabet[j] == selected[k]:
                        found <- j
                        break
            return log(0.0) if column < 0
            edge: i64 = state * width + column
            target: i64 = transitions[edge]
            return log(0.0) if target < 0
            return log(0.0) if weights[edge] == log(0.0)
            if not failed:
                value: f64 = total + weights[edge]
                if value > -67108864.0 and value < 67108864.0:
                    total <- value
                else:
                    checked: f64 = partition_log_product(total, weights[edge])
                    if checked != checked:
                        failed <- true
                    else:
                        total <- checked
            state <- target
    return log(0.0) if final[state] == log(0.0)
    return log(-1.0) if failed
    return partition_log_product(total, final[state])

def log_add_present(x: f64, y: f64) -> f64:
    return x + log1p(exp(y - x)) if x >= y else y + log1p(exp(x - y))

# Stable log-sum, including unreachable states.
def log_add(x: f64, y: f64) -> f64:
    return y if x == log(0.0)
    return x if y == log(0.0)
    return log_add_present(x, y)

# Detect a distorted log-sum correction at the posterior normalization tolerance.
def partition_log_add(x: f64, y: f64) -> f64:
    return y if x == log(0.0)
    return x if y == log(0.0)
    larger: f64 = x if x >= y else y
    smaller: f64 = y if x >= y else x
    correction: f64 = log1p(exp(smaller - larger))
    result: f64 = larger + correction
    # Below 2^26, binary64 round-to-nearest error is less than 2^-27.
    return result if result > -67108864.0 and result < 67108864.0
    roundoff: f64 = (result - larger) - correction
    return log(-1.0) if roundoff >= 1.01e-8 or roundoff <= -1.01e-8
    return result

# TwoSum recovers the rounding residual of a finite log-weight addition.
def partition_log_product(x: f64, y: f64) -> f64:
    result: f64 = x + y
    return log(-1.0) if result == log(0.0) or result == -log(0.0) or result != result
    return result if result > -67108864.0 and result < 67108864.0
    virtual: f64 = result - x
    residual: f64 = (x - (result - virtual)) + (y - virtual)
    return log(-1.0) if residual != residual or residual >= 1.01e-8 or residual <= -1.01e-8
    return result

# Sum off-reference masses and log(max(1, row mass)) without cancellation.
def tail_mass_summary(log_probs: view[f64], reference: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = reference.len.i64()
    return [log(0.0), 0.0] if m == 0
    width: i64 = log_probs.len.i64() / m
    total, scale, _ =
        for k in 0..<m |total: f64 = log(0.0), scale: f64 = 0.0, correction: f64 = 0.0| -> (total, scale, correction):
            row, next_total =
                for j in 0..<width |row: f64 = log(0.0), off: f64 = total| -> (row, off):
                    reading: f64 = log_probs[k * width + j]
                    row <- log_add(row, reading)
                    off <- log_add(off, reading) if j != reference[k] else off
            total <- next_total
            excess: f64 = row if row > 0.0 else 0.0
            adjusted: f64 = excess - correction
            next: f64 = scale + adjusted
            correction <- (next - scale) - adjusted
            scale <- next
    return [total, scale]

# Refresh one block, or every block for index -1, then combine their summaries.
# The caller owns a pair of f64 values per block: log off-mass and log scale.
def tail_block_summary(log_probs: view[f64], reference: view[i64], blocks: mutable view[f64], block_size: i64, index: i64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = reference.len.i64()
    return [] if m == 0 or block_size <= 0 or index < -1 or index >= m
    return [] if log_probs.len.i64() % m != 0
    width: i64 = log_probs.len.i64() / m
    return [] if width == 0
    count: i64 = (m - 1) / block_size + 1
    return [] if blocks.len.i64() / 2 != count or blocks.len.i64() % 2 != 0
    first: i64 = 0 if index == -1 else index / block_size
    end: i64 = count if index == -1 else first + 1
    for b in first..<end:
        start: i64 = b * block_size
        remaining: i64 = m - start
        stop: i64 = start + (block_size if block_size < remaining else remaining)
        for k in start..<stop:
            return [] if reference[k] < 0 or reference[k] >= width
        off, block_scale, _ =
            for k in start..<stop |off: f64 = log(0.0), block_scale: f64 = 0.0, block_correction: f64 = 0.0| -> (off, block_scale, block_correction):
                peak, peak_index =
                    for j in 0..<width |peak: f64 = log(0.0), peak_index: i64 = -1| -> (peak, peak_index):
                        reading: f64 = log_probs[k * width + j]
                        if j != reference[k] and reading > peak:
                            peak <- reading
                            peak_index <- j
                last: i64 = width if peak_index >= 0 else 0
                rest, _ =
                    for j in 0..<last |rest: f64 = 0.0, correction: f64 = 0.0| -> (rest, correction):
                        reading: f64 = log_probs[k * width + j]
                        if j != reference[k] and j != peak_index and reading != log(0.0):
                            adjusted: f64 = exp(reading - peak) - correction
                            next: f64 = rest + adjusted
                            correction <- (next - rest) - adjusted
                            rest <- next
                row_off: f64 = peak + log1p(rest) if peak_index >= 0 else peak
                row: f64 = log_add(log_probs[k * width + reference[k]], row_off)
                off <- log_add(off, row_off)
                excess: f64 = row if row > 0.0 else 0.0
                adjusted: f64 = excess - block_correction
                next: f64 = block_scale + adjusted
                block_correction <- (next - block_scale) - adjusted
                block_scale <- next
        blocks[b * 2] <- off
        blocks[b * 2 + 1] <- block_scale
    total, scale, _ =
        for b in 0..<count |total: f64 = log(0.0), scale: f64 = 0.0, correction: f64 = 0.0| -> (total, scale, correction):
            total <- log_add(total, blocks[b * 2])
            adjusted: f64 = blocks[b * 2 + 1] - correction
            next: f64 = scale + adjusted
            correction <- (next - scale) - adjusted
            scale <- next
    return [total, scale]

# Search only through the number of positions; beyond it the tail is empty.
def initial_band_changes_scaled(log_off: f64, log_factor: f64, log_slack: f64, length: i64) -> i64:
    # Reserve a representable sentinel for a tail beyond the final position.
    return -1 if length < 0 or length == 9223372036854775807
    return 1 if log_off == log(0.0)
    return 1 if length == 0
    first: f64 = log_off + log_factor
    return -1 if first == log(0.0) or first == -log(0.0) or first != first
    return 1 if first <= log_slack
    # Above a threshold below one, C*S^j/j! is first increasing and then
    # decreasing. Since j=1 failed, its qualifying indices form a suffix.
    for _ in 0..<64 |low: i64 = 1, high: i64 = length + 1|:
        return high if high - low <= 1
        j: i64 = low + (high - low) / 2
        estimate: f64 = j.f64() * log_off - lgamma((j + 1).f64()) + log_factor
        return -1 if estimate == log(0.0) or estimate == -log(0.0) or estimate != estimate
        high <- j if estimate <= log_slack else high
        low <- j if estimate > log_slack else low
    return length + 1

# Separate the selected format path from all different accepted paths.
def format_partition(log_probs: view[f64], alphabet: view[i64], selected: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = selected.len.i64()
    count: i64 = alphabet.len.i64()
    return [] if m == 0 or count == 0 or log_probs.len.i64() != m * count
    width: i64 = m + 2
    missing: f64 = log(0.0)
    alternatives: darray[f64] = [missing for _ in 0..<(2 * width)]
    matched: darray[f64] = [0.0]
    state: darray[i64] = [1]
    for k in 0..<m:
        here: i64 = (k % 2) * width
        next: i64 = ((k + 1) % 2) * width
        for n in 0..<width:
            alternatives[next + n] <- missing
        for n in 1..<(m - k + 1):
            for j in 0..<count:
                arity: i64 = alphabet[j]
                return [] if arity < 0
                continue if arity > m - k - 1
                target: i64 = n - 1 + arity
                continue if target > m - k - 1
                reading: f64 = log_probs[k * count + j]
                source: f64 = alternatives[here + n]
                if source != missing and reading != missing:
                    through: f64 = partition_log_product(source, reading)
                    return [] if through == missing or through == -missing or through != through
                    combined: f64 = partition_log_add(alternatives[next + target], through)
                    return [] if combined != combined
                    alternatives[next + target] <- combined
                if n == state[0] and matched[0] != missing and arity != selected[k] and reading != missing:
                    through: f64 = partition_log_product(matched[0], reading)
                    return [] if through == missing or through == -missing or through != through
                    combined: f64 = partition_log_add(alternatives[next + target], through)
                    return [] if combined != combined
                    alternatives[next + target] <- combined
        chosen: i64 =
            for j in 0..<count |found: i64 = -1| -> found:
                if alphabet[j] == selected[k]:
                    found <- j
                    break
        if chosen < 0 or selected[k] < 0 or selected[k] > m - k - 1 or state[0] < 1:
            matched[0] <- missing
        else:
            state[0] <- state[0] - 1 + selected[k]
            reading: f64 = log_probs[k * count + chosen]
            if state[0] > m - k - 1 or matched[0] == missing or reading == missing:
                matched[0] <- missing
            else:
                value: f64 = partition_log_product(matched[0], reading)
                return [] if value == missing or value == -missing or value != value
                matched[0] <- value
    return [matched[0] if state[0] == 0 else missing, alternatives[(m % 2) * width]]

# Exact format decoding in log space, used when linear-space paths underflow.
def decode_log(log_probs: view[f64], alphabet: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    alphabet_size: i64 = alphabet.len.i64()
    return [] if alphabet_size == 0 or log_probs.len.i64() % alphabet_size != 0
    m: i64 = log_probs.len.i64() / alphabet_size
    return [] if m == 0
    max_arity: i64 =
        for j in 0..<alphabet_size |largest: i64 = 0| -> largest:
            return [] if alphabet[j] < 0
            largest <- alphabet[j] if alphabet[j] > largest and alphabet[j] < m else largest
    offsets: darray[i64] =
        for k in 0..<(m + 1) |offsets: darray[i64] = [0 for _ in 0..<(m + 2)]| -> offsets:
            offsets[k + 1] <- offsets[k] + live(k, m, max_arity) + 1
    width: i64 = m + 2
    unreachable: f64 = log(0.0)
    completable: darray[bool] = [i == offsets[m] for i in 0..<offsets[m + 1]]
    for step in 0..<m:
        k: i64 = m - 1 - step
        here_top: i64 = live(k, m, max_arity)
        next_top: i64 = live(k + 1, m, max_arity)
        for j in 0..<alphabet_size:
            arity: i64 = alphabet[j]
            continue if arity > next_top or log_probs[k * alphabet_size + j] == unreachable
            limit: i64 = next_top + 1 - arity
            top: i64 = limit if limit < here_top else here_top
            for state in 1..<(top + 1):
                target: i64 = state - 1 + arity
                if completable[offsets[k + 1] + target]:
                    completable[offsets[k] + state] <- true
    return [] if not completable[1]
    forward: darray[f64] = [0.0 if i == 1 else unreachable for i in 0..<offsets[m + 1]]
    best: darray[f64] = [0.0 if i == 1 else unreachable for i in 0..<(2 * width)]
    choice: darray[i64] = [0 for _ in 0..<offsets[m + 1]]
    for k in 0..<m:
        here_top: i64 = live(k, m, max_arity)
        next_top: i64 = live(k + 1, m, max_arity)
        best_source: i64 = (k % 2) * width
        best_target: i64 = ((k + 1) % 2) * width
        for state in 0..<(next_top + 1):
            best[best_target + state] <- unreachable
        for j in 0..<alphabet_size:
            arity: i64 = alphabet[j]
            continue if arity > next_top
            step: f64 = log_probs[k * alphabet_size + j]
            limit: i64 = next_top + 1 - arity
            top: i64 = limit if limit < here_top else here_top
            for state in 1..<(top + 1):
                target: i64 = state - 1 + arity
                continue if not completable[offsets[k + 1] + target]
                cell: i64 = offsets[k + 1] + target
                source: f64 = forward[offsets[k] + state]
                through: f64 = source + step
                return [log(-1.0)] if source != unreachable and step != unreachable and (through == unreachable or through == -unreachable or through != through)
                forward[cell] <- log_add(forward[cell], through)
                candidate: f64 = best[best_source + state] + step
                return [log(-1.0)] if best[best_source + state] != unreachable and step != unreachable and (candidate == unreachable or candidate == -unreachable or candidate != candidate)
                if candidate > best[best_target + target]:
                    best[best_target + target] <- candidate
                    choice[cell] <- j
    log_z: f64 = forward[offsets[m]]
    return [] if log_z == unreachable
    result: darray[f64] = [0.0 for _ in 0..<(1 + m + m * alphabet_size)]
    result[0] <- log_z
    trace: darray[i64] = [0]
    for step in 0..<m:
        k: i64 = m - step
        arity: i64 = alphabet[choice[offsets[k] + trace[0]]]
        result[k] <- arity.f64()
        trace[0] <- trace[0] + 1 - arity
    backward: mutable darray[f64] = [0.0 if i == (m % 2) * width else unreachable for i in 0..<(2 * width)]
    for step in 0..<m:
        k: i64 = m - 1 - step
        here_top: i64 = live(k, m, max_arity)
        next_top: i64 = live(k + 1, m, max_arity)
        backward_here: i64 = (k % 2) * width
        backward_next: i64 = ((k + 1) % 2) * width
        for state in 0..<(here_top + 1):
            backward[backward_here + state] <- unreachable
        for j in 0..<alphabet_size:
            arity: i64 = alphabet[j]
            continue if arity > next_top
            reading: f64 = log_probs[k * alphabet_size + j]
            limit: i64 = next_top + 1 - arity
            top: i64 = limit if limit < here_top else here_top
            marginal: f64 =
                for state in 1..<(top + 1) |backward, total: f64 = unreachable| -> total:
                    target: i64 = state - 1 + arity
                    source: f64 = forward[offsets[k] + state]
                    continue if source == unreachable
                    suffix: f64 = backward[backward_next + target]
                    through: f64 = reading + suffix
                    return [log(-1.0)] if reading != unreachable and suffix != unreachable and (through == unreachable or through == -unreachable or through != through)
                    backward[backward_here + state] <- log_add(backward[backward_here + state], through)
                    weighted: f64 = source + through
                    return [log(-1.0)] if source != unreachable and through != unreachable and (weighted == unreachable or weighted == -unreachable or weighted != weighted)
                    total <- log_add(total, weighted)
            result[1 + m + k * alphabet_size + j] <- exp(marginal - log_z)
    return result

# Sum-product only, retaining two state rows; no maximum or marginal tables.
def prior_normalizer(log_probs: view[f64], alphabet: view[i64], transitions: view[i64], prior: view[f64], final: view[f64], start: i64) -> f64 can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    states: i64 = final.len.i64()
    m: i64 = log_probs.len.i64() / width
    unreachable: f64 = log(0.0)
    return final[start] if m == 0
    rows, bounds =
        for k in 0..<m |rows: darray[f64] = [0.0 if i == start else unreachable for i in 0..<(2 * states)], bounds: darray[i64] = [start, start, 0, -1]| -> (rows, bounds):
            here: i64 = (k % 2) * states
            next: i64 = ((k + 1) % 2) * states
            here_bound: i64 = (k % 2) * 2
            next_bound: i64 = ((k + 1) % 2) * 2
            # Every cell outside the old destination envelope is already unreachable.
            for state in bounds[next_bound]..<(bounds[next_bound + 1] + 1) |rows|:
                rows[next + state] <- unreachable
            bounds[next_bound] <- states
            bounds[next_bound + 1] <- -1
            for state in bounds[here_bound]..<(bounds[here_bound + 1] + 1) |rows, bounds|:
                continue if rows[here + state] == unreachable
                for j in 0..<width |rows, bounds|:
                    edge: i64 = state * width + j
                    target: i64 = transitions[edge]
                    continue if target < 0
                    reading: f64 = log_probs[k * width + j]
                    edge_weight: f64 = prior[edge]
                    continue if reading == unreachable or edge_weight == unreachable
                    weight: f64 = reading + edge_weight
                    return log(-1.0) if weight == unreachable or weight == -unreachable
                    through: f64 = rows[here + state] + weight
                    return log(-1.0) if through == unreachable or through == -unreachable
                    existing: f64 = rows[next + target]
                    rows[next + target] <- through if existing == unreachable else log_add_present(existing, through)
                    bounds[next_bound] <- target if target < bounds[next_bound] else bounds[next_bound]
                    bounds[next_bound + 1] <- target if target > bounds[next_bound + 1] else bounds[next_bound + 1]
    return
        for state in bounds[(m % 2) * 2]..<(bounds[(m % 2) * 2 + 1] + 1) |total: f64 = unreachable| -> total:
            last: f64 = rows[(m % 2) * states + state]
            continue if last == unreachable or final[state] == unreachable
            weighted: f64 = last + final[state]
            return log(-1.0) if weighted == unreachable or weighted == -unreachable
            total <- log_add(total, weighted)

# Sum the selected path and every different path separately. Empty output
# signals finite arithmetic overflow; -inf denotes absent mass.
def prior_partition(log_probs: view[f64], alphabet: view[i64], transitions: view[i64], prior: view[f64], final: view[f64], start: i64, selected: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    states: i64 = final.len.i64()
    m: i64 = selected.len.i64()
    unreachable: f64 = log(0.0)
    rows, bounds, matched_state, matched =
        for k in 0..<m |rows: darray[f64] = [unreachable for _ in 0..<(2 * states)], bounds: darray[i64] = [states, -1, states, -1], matched_state: i64 = start, matched: f64 = 0.0| -> (rows, bounds, matched_state, matched):
            here: i64 = (k % 2) * states
            next: i64 = ((k + 1) % 2) * states
            here_bound: i64 = (k % 2) * 2
            next_bound: i64 = ((k + 1) % 2) * 2
            for state in bounds[next_bound]..<(bounds[next_bound + 1] + 1) |rows|:
                rows[next + state] <- unreachable
            bounds[next_bound] <- states
            bounds[next_bound + 1] <- -1
            low: i64 = matched_state if matched != unreachable and matched_state < bounds[here_bound] else bounds[here_bound]
            high: i64 = matched_state if matched != unreachable and matched_state > bounds[here_bound + 1] else bounds[here_bound + 1]
            for state in low..<(high + 1) |rows, bounds|:
                source: f64 = rows[here + state]
                same: bool = state == matched_state and matched != unreachable
                continue if source == unreachable and not same
                for j in 0..<width |rows, bounds|:
                    edge: i64 = state * width + j
                    target: i64 = transitions[edge]
                    continue if target < 0
                    reading: f64 = log_probs[k * width + j]
                    edge_weight: f64 = prior[edge]
                    continue if reading == unreachable or edge_weight == unreachable
                    weight: f64 = partition_log_product(reading, edge_weight)
                    continue if source == unreachable and (not same or alphabet[j] == selected[k])
                    return [] if weight != weight
                    if source != unreachable:
                        through: f64 = partition_log_product(source, weight)
                        return [] if through != through
                        combined: f64 = partition_log_add(rows[next + target], through)
                        return [] if combined != combined
                        rows[next + target] <- combined
                    bounds[next_bound] <- target if target < bounds[next_bound] else bounds[next_bound]
                    bounds[next_bound + 1] <- target if target > bounds[next_bound + 1] else bounds[next_bound + 1]
                    if same and alphabet[j] != selected[k]:
                        through: f64 = partition_log_product(matched, weight)
                        return [] if through != through
                        combined: f64 = partition_log_add(rows[next + target], through)
                        return [] if combined != combined
                        rows[next + target] <- combined
            if matched != unreachable:
                chosen: i64 =
                    for j in 0..<width |chosen: i64 = -1| -> chosen:
                        if alphabet[j] == selected[k]:
                            chosen <- j
                            break
                if chosen < 0:
                    matched <- unreachable
                else:
                    edge: i64 = matched_state * width + chosen
                    target: i64 = transitions[edge]
                    reading: f64 = log_probs[k * width + chosen]
                    edge_weight: f64 = prior[edge]
                    if target < 0 or reading == unreachable or edge_weight == unreachable:
                        matched <- unreachable
                    else:
                        weight: f64 = partition_log_product(reading, edge_weight)
                        return [] if weight != weight
                        value: f64 = partition_log_product(matched, weight)
                        return [] if value != value
                        matched <- value
                        matched_state <- target
    selected_weight: f64 =
        if matched == unreachable or final[matched_state] == unreachable:
            unreachable
        else:
            value: f64 = partition_log_product(matched, final[matched_state])
            return [] if value != value
            value
    alternative: f64 =
        for state in bounds[(m % 2) * 2]..<(bounds[(m % 2) * 2 + 1] + 1) |total: f64 = unreachable| -> total:
            last: f64 = rows[(m % 2) * states + state]
            continue if last == unreachable or final[state] == unreachable
            value: f64 = partition_log_product(last, final[state])
            return [] if value != value
            combined: f64 = partition_log_add(total, value)
            return [] if combined != combined
            total <- combined
    return [selected_weight, alternative]

# Max-product and traceback only. Traversal and strict ties match decode_prior.
def prior_best(log_probs: view[f64], alphabet: view[i64], transitions: view[i64], prior: view[f64], final: view[f64], start: i64) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    states: i64 = final.len.i64()
    m: i64 = log_probs.len.i64() / width
    unreachable: f64 = log(0.0)
    return [] if m == 0
    rows, choice, bounds =
        for k in 0..<m |rows: darray[f64] = [0.0 if i == start else log(0.0) for i in 0..<(2 * states)], choice: darray[i64] = [-1 for _ in 0..<((m + 1) * states)], bounds: darray[i64] = [start, start, 0, -1]| -> (rows, choice, bounds):
            here: i64 = (k % 2) * states
            next: i64 = ((k + 1) % 2) * states
            here_bound: i64 = (k % 2) * 2
            next_bound: i64 = ((k + 1) % 2) * 2
            for state in bounds[next_bound]..<(bounds[next_bound + 1] + 1) |rows|:
                rows[next + state] <- log(0.0)
            bounds[next_bound] <- states
            bounds[next_bound + 1] <- -1
            for state in bounds[here_bound]..<(bounds[here_bound + 1] + 1) |rows, choice, bounds|:
                continue if rows[here + state] == log(0.0)
                for j in 0..<width |rows, choice, bounds|:
                    edge: i64 = state * width + j
                    target: i64 = transitions[edge]
                    continue if target < 0
                    reading: f64 = log_probs[k * width + j]
                    edge_weight: f64 = prior[edge]
                    continue if reading == unreachable or edge_weight == unreachable
                    weight: f64 = partition_log_product(reading, edge_weight)
                    return [] if weight != weight
                    candidate: f64 = partition_log_product(rows[here + state], weight)
                    return [] if candidate != candidate
                    if candidate > rows[next + target]:
                        rows[next + target] <- candidate
                        choice[(k + 1) * states + target] <- edge
                        bounds[next_bound] <- target if target < bounds[next_bound] else bounds[next_bound]
                        bounds[next_bound + 1] <- target if target > bounds[next_bound + 1] else bounds[next_bound + 1]
    terminal: i64 =
        for state in bounds[(m % 2) * 2]..<(bounds[(m % 2) * 2 + 1] + 1) |top: f64 = log(0.0), terminal: i64 = -1| -> terminal:
            last: f64 = rows[(m % 2) * states + state]
            continue if last == unreachable or final[state] == unreachable
            candidate: f64 = partition_log_product(last, final[state])
            return [] if candidate != candidate
            if candidate > top:
                top <- candidate
                terminal <- state
    return [] if terminal < 0
    return
        for step in 0..<m |selected: darray[i64] = [0 for _ in 0..<m], state: i64 = terminal| -> selected:
            edge: i64 = choice[(m - step) * states + state]
            selected[m - step - 1] <- alphabet[edge % width]
            state <- edge / width

# A typed Python result; absence is represented by null, not an empty packed array.
struct PriorDecoded:
    log_z: f64
    arities: darray[i64]
    marginals: darray[darray[f64]]

# A conservative magnitude envelope for every forward, backward and split sum.
def prior_small_arithmetic(log_probs: view[f64], prior: view[f64], final: view[f64], width: i64) -> bool:
    m: i64 = log_probs.len.i64() / width
    unreachable: f64 = log(0.0)
    reading_bound: f64 =
        for k in 0..<m |total: f64 = 0.0| -> total:
            peak: f64 =
                for j in 0..<width |peak: f64 = 0.0| -> peak:
                    value: f64 = log_probs[k * width + j]
                    continue if value == unreachable
                    magnitude: f64 = -value if value < 0.0 else value
                    peak <- magnitude if magnitude > peak else peak
            total += peak
    edge_bound: f64 =
        for i in 0..<prior.len.i64() |peak: f64 = 0.0| -> peak:
            value: f64 = prior[i]
            continue if value == unreachable
            magnitude: f64 = -value if value < 0.0 else value
            peak <- magnitude if magnitude > peak else peak
    final_bound: f64 =
        for i in 0..<final.len.i64() |peak: f64 = 0.0| -> peak:
            value: f64 = final[i]
            continue if value == unreachable
            magnitude: f64 = -value if value < 0.0 else value
            peak <- magnitude if magnitude > peak else peak
    bound: f64 = reading_bound + m.f64() * (edge_bound + log(width.f64())) + final_bound
    # The extra factor of four leaves room for split subtraction and rounding.
    return bound < 16777216.0

# Weighted deterministic prior automaton (§27), including any format restriction.
# Caller validates dimensions and state indices; -1 denotes a forbidden transition.
def decode_prior(log_probs: view[f64], alphabet: view[i64], transitions: view[i64], prior: view[f64], final: view[f64], start: i64) -> PriorDecoded? can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    states: i64 = final.len.i64()
    m: i64 = log_probs.len.i64() / width
    unreachable: f64 = log(0.0)
    if m == 0:
        return null if final[start] == unreachable
        return PriorDecoded{log_z: final[start], arities: [], marginals: []}
    small: bool = prior_small_arithmetic(log_probs, prior, final, width)
    forward, best, choice, bounds =
        for k in 0..<m |forward: darray[f64] = [0.0 if i == start else log(0.0) for i in 0..<((m + 1) * states)], best: darray[f64] = [0.0 if i == start else log(0.0) for i in 0..<(2 * states)], choice: darray[i64] = [-1 for _ in 0..<((m + 1) * states)], bounds: darray[i64] = [start if i < 2 else (states if i % 2 == 0 else -1) for i in 0..<(2 * (m + 1))]| -> (forward, best, choice, bounds):
            here: i64 = (k % 2) * states
            next: i64 = ((k + 1) % 2) * states
            # The destination row was last used at position k - 1.
            if k > 0:
                for state in bounds[2 * (k - 1)]..<(bounds[2 * (k - 1) + 1] + 1) |best|:
                    best[next + state] <- unreachable
            for state in bounds[2 * k]..<(bounds[2 * k + 1] + 1) |forward, best, choice, bounds|:
                continue if forward[k * states + state] == log(0.0)
                for j in 0..<width |forward, best, choice, bounds|:
                    edge: i64 = state * width + j
                    target: i64 = transitions[edge]
                    continue if target < 0
                    cell: i64 = (k + 1) * states + target
                    reading: f64 = log_probs[k * width + j]
                    edge_weight: f64 = prior[edge]
                    continue if reading == unreachable or edge_weight == unreachable
                    weight: f64 = reading + edge_weight if small else partition_log_product(reading, edge_weight)
                    return null if weight != weight
                    through: f64 = forward[k * states + state] + weight if small else partition_log_product(forward[k * states + state], weight)
                    return null if through != through
                    combined: f64 = log_add(forward[cell], through) if small else partition_log_add(forward[cell], through)
                    return null if combined != combined
                    forward[cell] <- combined
                    if target < bounds[2 * (k + 1)]:
                        bounds[2 * (k + 1)] <- target
                    if target > bounds[2 * (k + 1) + 1]:
                        bounds[2 * (k + 1) + 1] <- target
                    candidate: f64 = best[here + state] + weight if small else partition_log_product(best[here + state], weight)
                    return null if candidate != candidate
                    if candidate > best[next + target]:
                        best[next + target] <- candidate
                        choice[cell] <- edge
    log_z, terminal =
        for state in bounds[2 * m]..<(bounds[2 * m + 1] + 1) |log_z: f64 = log(0.0), top: f64 = log(0.0), terminal: i64 = -1| -> (log_z, terminal):
            continue if forward[m * states + state] == unreachable or final[state] == unreachable
            weighted: f64 = forward[m * states + state] + final[state] if small else partition_log_product(forward[m * states + state], final[state])
            return null if weighted != weighted
            combined: f64 = log_add(log_z, weighted) if small else partition_log_add(log_z, weighted)
            return null if combined != combined
            log_z <- combined
            candidate: f64 = best[(m % 2) * states + state] + final[state] if small else partition_log_product(best[(m % 2) * states + state], final[state])
            return null if candidate != candidate
            if candidate > top:
                top <- candidate
                terminal <- state
    return null if terminal < 0
    decoded: darray[i64] =
        for step in 0..<m |decoded: darray[i64] = [0 for _ in 0..<m], state: i64 = terminal| -> decoded:
            edge: i64 = choice[(m - step) * states + state]
            decoded[m - step - 1] <- alphabet[edge % width]
            state <- edge / width
    marginals: darray[darray[f64]] =
        for step in 0..<m |result: darray[darray[f64]] = [[0.0 for _ in 0..<width] for _ in 0..<m], backward: darray[f64] = [final[i % states] if i / states == m % 2 and forward[m * states + i % states] != unreachable else unreachable for i in 0..<(2 * states)]| -> result:
            k: i64 = m - 1 - step
            here: i64 = (k % 2) * states
            next: i64 = ((k + 1) % 2) * states
            # The reused row contains only support from position k + 2.
            if k + 2 <= m:
                for state in bounds[2 * (k + 2)]..<(bounds[2 * (k + 2) + 1] + 1) |backward|:
                    backward[here + state] <- unreachable
            for state in bounds[2 * k]..<(bounds[2 * k + 1] + 1) |backward, result|:
                continue if forward[k * states + state] == log(0.0)
                for j in 0..<width |backward, result|:
                    edge: i64 = state * width + j
                    target: i64 = transitions[edge]
                    continue if target < 0
                    reading: f64 = log_probs[k * width + j]
                    edge_weight: f64 = prior[edge]
                    suffix: f64 = backward[next + target]
                    continue if reading == unreachable or edge_weight == unreachable or suffix == unreachable
                    weight: f64 = reading + edge_weight if small else partition_log_product(reading, edge_weight)
                    return null if weight != weight
                    through: f64 = weight + suffix if small else partition_log_product(weight, suffix)
                    return null if through != through
                    combined: f64 = log_add(backward[here + state], through) if small else partition_log_add(backward[here + state], through)
                    return null if combined != combined
                    backward[here + state] <- combined
                    first: f64 = forward[k * states + state] + reading if small else partition_log_product(forward[k * states + state], reading)
                    return null if first != first
                    second: f64 = first + edge_weight if small else partition_log_product(first, edge_weight)
                    return null if second != second
                    third: f64 = second + suffix if small else partition_log_product(second, suffix)
                    return null if third != third
                    exponent: f64 = third - log_z if small else partition_log_product(third, -log_z)
                    return null if exponent != exponent
                    result[k][j] <- result[k][j] + exp(exponent)
    return PriorDecoded{log_z: log_z, arities: decoded, marginals: marginals}

# The banded cursor of THEORY §23.4. The caller owns the tables, `width`
# states per row, and keeps rows current around a cursor; these functions recompute rows in
# place. Row `k` holds states `low[k] ..= high[k]`. Both sum and max tables hold log weights.

# For arity `a` at position `i`: the first in-band state `s ≥ 1` whose successor `s − 1 + a` is
# in band at `i + 1`, and how many consecutive such states there are.
def moves(i: i64, a: i64, low: view[i64], high: view[i64]) -> (first: i64, count: i64) can[Abort.Panic]:
    first: i64 =
        lowest: i64 = low[i] if low[i] > 1 else 1
        low[i + 1] + 1 - a if low[i + 1] + 1 - a > lowest else lowest
    last: i64 = high[i] if high[i] < high[i + 1] + 1 - a else high[i + 1] + 1 - a
    return first, (last - first + 1 if last >= first else 0)

# One-shot banded sum and maximum, with an empty result for no accepted path.
# A NaN result signals overflow while adding finite log weights.
def banded_format(log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    count: i64 = alphabet.len.i64()
    m: i64 = low.len.i64() - 1
    return [] if count == 0 or m <= 0 or high.len.i64() != m + 1 or log_probs.len.i64() != m * count
    return [] if low[0] > 1 or high[0] < 1 or low[m] > 0 or high[m] < 0
    width: i64 = m + 2
    missing: f64 = log(0.0)
    forward: darray[f64] = [0.0 if i == 1 else missing for i in 0..<(2 * width)]
    best: darray[f64] = [0.0 if i == 1 else missing for i in 0..<(2 * width)]
    choice: darray[i64] = [0 for _ in 0..<((m + 1) * width)]
    for k in 0..<m:
        here: i64 = (k % 2) * width
        next: i64 = ((k + 1) % 2) * width
        for state in low[k + 1]..<(high[k + 1] + 1):
            forward[next + state] <- missing
            best[next + state] <- missing
        for j in 0..<count:
            arity: i64 = alphabet[j]
            return [] if arity < 0
            step: f64 = log_probs[k * count + j]
            continue if step == missing
            run: (first: i64, count: i64) = moves(k, arity, low, high)
            for t in 0..<run.count:
                state: i64 = run.first + t
                target: i64 = state - 1 + arity
                if forward[here + state] != missing:
                    incoming: f64 = forward[here + state] + step
                    return [log(-1.0)] if incoming == missing or incoming == -missing or incoming != incoming
                    forward[next + target] <- log_add(forward[next + target], incoming)
                if best[here + state] != missing:
                    candidate: f64 = best[here + state] + step
                    return [log(-1.0)] if candidate == missing or candidate == -missing or candidate != candidate
                    if candidate > best[next + target]:
                        best[next + target] <- candidate
                        choice[(k + 1) * width + target] <- j
    log_z: f64 = forward[(m % 2) * width]
    return [] if log_z == missing
    result: darray[f64] = [0.0 for _ in 0..<(m + 2)]
    result[0] <- log_z
    result[1] <- best[(m % 2) * width]
    trace_state: darray[i64] = [0]
    for step in 0..<m:
        k: i64 = m - step
        arity: i64 = alphabet[choice[k * width + trace_state[0]]]
        result[1 + k] <- arity.f64()
        trace_state[0] <- trace_state[0] + 1 - arity
    return result

# Enclose all reachable sum or maximum states; interior holes are retained.
def support_envelope(sums: view[f64], maxima: view[f64], offsets: view[i64], low: view[i64], high: view[i64], row: i64) -> (first: i64, last: i64) can[Abort.Panic]:
    first: i64 =
        for n in low[row]..<(high[row] + 1) |first: i64 = high[row] + 1| -> first:
            index: i64 = offsets[row] + n - low[row]
            if sums[index] != log(0.0) or maxima[index] != log(0.0):
                first <- n
                break
    last: i64 =
        for back in 0..<(high[row] - first + 1) |last: i64 = first - 1| -> last:
            n: i64 = high[row] - back
            index: i64 = offsets[row] + n - low[row]
            if sums[index] != log(0.0) or maxima[index] != log(0.0):
                last <- n
                break
    return first, last

def arities_ordered(alphabet: view[i64]) -> bool can[Abort.Panic]:
    for j in 1..<alphabet.len.i64():
        return false if alphabet[j] < alphabet[j - 1]
    return true

# Recompute forward and backward rows in log space.
def advance_ragged_log(forward: mutable view[f64], forward_max: mutable view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], start: i64, stop: i64) -> i64 can[Abort.Panic]:
    arities: i64 = alphabet.len.i64()
    ordered: bool = arities_ordered(alphabet)
    for i in start..<stop:
        target: i64 = offsets[i + 1]
        for n in low[i + 1]..<(high[i + 1] + 1):
            forward[target + n - low[i + 1]] <- log(0.0)
            forward_max[target + n - low[i + 1]] <- log(0.0)
        active: (first: i64, last: i64) = support_envelope(forward, forward_max, offsets, low, high, i)
        continue if active.first > active.last
        minimum: i64 = active.first if active.first > 1 else 1
        for j in 0..<arities:
            break if ordered and alphabet[j] > high[i + 1] + 1 - minimum
            step: f64 = log_probs[i * arities + j]
            continue if step == log(0.0)
            run: (first: i64, count: i64) = moves(i, alphabet[j], low, high)
            first: i64 = run.first if run.first > active.first else active.first
            end: i64 = (run.first + run.count) if run.first + run.count < active.last + 1 else active.last + 1
            for n in first..<end:
                source: i64 = offsets[i] + n - low[i]
                cell: i64 = target + n - 1 + alphabet[j] - low[i + 1]
                if forward[source] != log(0.0):
                    incoming: f64 = forward[source] + step
                    return -1 if incoming == log(0.0) or incoming == -log(0.0) or incoming != incoming
                    forward[cell] <- incoming if forward[cell] == log(0.0) else log_add_present(forward[cell], incoming)
                candidate: f64 = forward_max[source] + step
                return -1 if forward_max[source] != log(0.0) and (candidate == log(0.0) or candidate == -log(0.0) or candidate != candidate)
                forward_max[cell] <- candidate if candidate > forward_max[cell] else forward_max[cell]
    return stop - start

def retreat_ragged_log(backward: mutable view[f64], backward_max: mutable view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], start: i64, stop: i64) -> i64 can[Abort.Panic]:
    arities: i64 = alphabet.len.i64()
    ordered: bool = arities_ordered(alphabet)
    for back in 0..<(start - stop):
        i: i64 = start - 1 - back
        for n in low[i]..<(high[i] + 1):
            backward[offsets[i] + n - low[i]] <- log(0.0)
            backward_max[offsets[i] + n - low[i]] <- log(0.0)
        active: (first: i64, last: i64) = support_envelope(backward, backward_max, offsets, low, high, i + 1)
        continue if active.first > active.last
        minimum: i64 = low[i] if low[i] > 1 else 1
        for j in 0..<arities:
            break if ordered and alphabet[j] > active.last + 1 - minimum
            step: f64 = log_probs[i * arities + j]
            continue if step == log(0.0)
            run: (first: i64, count: i64) = moves(i, alphabet[j], low, high)
            active_first: i64 = active.first + 1 - alphabet[j]
            active_end: i64 = active.last + 2 - alphabet[j]
            first: i64 = run.first if run.first > active_first else active_first
            end: i64 = (run.first + run.count) if run.first + run.count < active_end else active_end
            for n in first..<end:
                cell: i64 = offsets[i] + n - low[i]
                source: i64 = offsets[i + 1] + n - 1 + alphabet[j] - low[i + 1]
                if backward[source] != log(0.0):
                    incoming: f64 = backward[source] + step
                    return -1 if incoming == log(0.0) or incoming == -log(0.0) or incoming != incoming
                    backward[cell] <- incoming if backward[cell] == log(0.0) else log_add_present(backward[cell], incoming)
                candidate: f64 = backward_max[source] + step
                return -1 if backward_max[source] != log(0.0) and (candidate == log(0.0) or candidate == -log(0.0) or candidate != candidate)
                backward_max[cell] <- candidate if candidate > backward_max[cell] else backward_max[cell]
    return start - stop

# [log Z, best log weight] with word k replaced by log_row. The ordered flag
# may be true only if the supplied alphabet is nondecreasing.
def scores_ragged_with_order(forward: view[f64], forward_max: view[f64], backward: view[f64], backward_max: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], k: i64, log_row: view[f64], ordered: bool) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    left: (first: i64, last: i64) = support_envelope(forward, forward_max, offsets, low, high, k)
    right: (first: i64, last: i64) = support_envelope(backward, backward_max, offsets, low, high, k + 1)
    return [log(0.0), log(0.0)] if left.first > left.last or right.first > right.last
    minimum: i64 = left.first if left.first > 1 else 1
    total, log_x =
        for j in 0..<alphabet.len.i64() |total: f64 = log(0.0), log_x: f64 = log(0.0)| -> (total, log_x):
            break if ordered and alphabet[j] > right.last + 1 - minimum
            continue if log_row[j] == log(0.0)
            run: (first: i64, count: i64) = moves(k, alphabet[j], low, high)
            first_left: i64 = run.first if run.first > left.first else left.first
            first_right: i64 = right.first + 1 - alphabet[j]
            first: i64 = first_left if first_left > first_right else first_right
            end_left: i64 = (run.first + run.count) if run.first + run.count < left.last + 1 else left.last + 1
            end_right: i64 = right.last + 2 - alphabet[j]
            end: i64 = end_left if end_left < end_right else end_right
            for n in first..<end |total, log_x|:
                here: i64 = offsets[k] + n - low[k]
                next: i64 = offsets[k + 1] + n - 1 + alphabet[j] - low[k + 1]
                if forward[here] != log(0.0) and backward[next] != log(0.0):
                    partial: f64 = forward[here] + log_row[j]
                    return [log(-1.0), log(-1.0)] if partial == log(0.0) or partial == -log(0.0) or partial != partial
                    incoming: f64 = partial + backward[next]
                    return [log(-1.0), log(-1.0)] if incoming == log(0.0) or incoming == -log(0.0) or incoming != incoming
                    total <- incoming if total == log(0.0) else log_add_present(total, incoming)
                if forward_max[here] != log(0.0) and backward_max[next] != log(0.0):
                    partial: f64 = forward_max[here] + log_row[j]
                    return [log(-1.0), log(-1.0)] if partial == log(0.0) or partial == -log(0.0) or partial != partial
                    candidate: f64 = partial + backward_max[next]
                    return [log(-1.0), log(-1.0)] if candidate == log(0.0) or candidate == -log(0.0) or candidate != candidate
                    log_x <- candidate if candidate > log_x else log_x
    return [total, log_x]

# Compatibility entry point determines the ordering on each call.
def scores_ragged_log(forward: view[f64], forward_max: view[f64], backward: view[f64], backward_max: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], k: i64, log_row: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return scores_ragged_with_order(forward, forward_max, backward, backward_max, alphabet, low, high, offsets, k, log_row, arities_ordered(alphabet))

# [best log weight, its arities (m)], with forward max row `k` and backward max row `k + 1`
# current (THEORY §23.4, Theorem 23.10): the best state and arity at word `k`, then the best
# prefix traced back through the forward max rows and the best suffix forward through the
# backward max rows.
# Indexed traversal requires a permutation sorted by the supplied arities.
def trace_ragged_core(forward_max: view[f64], backward_max: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], k: i64, ordered: bool, indices: view[i64], indexed: bool) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    arities: i64 = alphabet.len.i64()
    m: i64 = low.len.i64() - 1
    left: (first: i64, last: i64) = support_envelope(forward_max, forward_max, offsets, low, high, k)
    right: (first: i64, last: i64) = support_envelope(backward_max, backward_max, offsets, low, high, k + 1)
    log_x, state, choice =
        for j in 0..<arities |log_x: f64 = log(0.0), state: i64 = 0, choice: i64 = 0| -> (log_x, state, choice):
            reading: f64 = log_probs[k * arities + j]
            continue if reading == log(0.0)
            run: (first: i64, count: i64) = moves(k, alphabet[j], low, high)
            first_left: i64 = run.first if run.first > left.first else left.first
            first_right: i64 = right.first + 1 - alphabet[j]
            first: i64 = first_left if first_left > first_right else first_right
            end_left: i64 = (run.first + run.count) if run.first + run.count < left.last + 1 else left.last + 1
            end_right: i64 = right.last + 2 - alphabet[j]
            end: i64 = end_left if end_left < end_right else end_right
            for n in first..<end |log_x, state, choice|:
                prefix: f64 = forward_max[offsets[k] + n - low[k]]
                suffix: f64 = backward_max[offsets[k + 1] + n - 1 + alphabet[j] - low[k + 1]]
                continue if prefix == log(0.0) or suffix == log(0.0)
                partial: f64 = prefix + reading
                return [log(-1.0)] if partial == log(0.0) or partial == -log(0.0) or partial != partial
                candidate: f64 = partial + suffix
                return [log(-1.0)] if candidate == log(0.0) or candidate == -log(0.0) or candidate != candidate
                if candidate > log_x:
                    log_x <- candidate
                    state <- n
                    choice <- j
    return [log_x] if log_x == log(0.0)
    result: darray[f64] = [0.0 for i in 0..<(m + 1)]
    result[0] <- log_x
    result[1 + k] <- alphabet[choice].f64()
    for back in 0..<k |before: i64 = state|:
        i: i64 = k - 1 - back
        best, source, arity, _ =
            for position in 0..<arities |best: f64 = log(0.0), source: i64 = 1, arity: i64 = 0, best_index: i64 = arities| -> (best, source, arity, best_index):
                j: i64 = indices[position] if indexed else position
                n: i64 = before + 1 - alphabet[j]
                if n < 1 or n < low[i]:
                    break if ordered
                    continue
                continue if n > high[i]
                candidate: f64 = forward_max[offsets[i] + n - low[i]] + log_probs[i * arities + j]
                if candidate > best or (indexed and candidate == best and candidate != log(0.0) and j < best_index):
                    best <- candidate
                    source <- n
                    arity <- alphabet[j]
                    best_index <- j
        result[1 + i] <- arity.f64()
        before <- source
    for i in (k + 1)..<m |after: i64 = state - 1 + alphabet[choice]|:
        best, target, arity, _ =
            for position in 0..<arities |best: f64 = log(0.0), target: i64 = 0, arity: i64 = 0, best_index: i64 = arities| -> (best, target, arity, best_index):
                j: i64 = indices[position] if indexed else position
                continue if after < 1
                if alphabet[j] > high[i + 1]:
                    break if ordered
                    continue
                n: i64 = after - 1 + alphabet[j]
                if n > high[i + 1]:
                    break if ordered
                    continue
                continue if n < low[i + 1]
                candidate: f64 = log_probs[i * arities + j] + backward_max[offsets[i + 1] + n - low[i + 1]]
                if candidate > best or (indexed and candidate == best and candidate != log(0.0) and j < best_index):
                    best <- candidate
                    target <- n
                    arity <- alphabet[j]
                    best_index <- j
        result[1 + i] <- arity.f64()
        after <- target
    return result

# The ordered flag may be true only for a nondecreasing alphabet.
def trace_ragged_with_order(forward_max: view[f64], backward_max: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], k: i64, ordered: bool) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return trace_ragged_core(forward_max, backward_max, log_probs, alphabet, low, high, offsets, k, ordered, alphabet, false)

# indices must be a permutation of the alphabet indices sorted by their arities.
def trace_ragged_indexed(forward_max: view[f64], backward_max: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], k: i64, indices: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return trace_ragged_core(forward_max, backward_max, log_probs, alphabet, low, high, offsets, k, true, indices, true)

# Compatibility entry point determines the ordering on each call.
def trace_ragged(forward_max: view[f64], backward_max: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], offsets: view[i64], k: i64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return trace_ragged_with_order(forward_max, backward_max, log_probs, alphabet, low, high, offsets, k, arities_ordered(alphabet))

# Least-risk certificate on an already parsed prefix tree. Opcodes follow the
# formula vocabulary: true, false, not, and, or, xor. Ties prefer the right child.
def certificate(ops: view[i64], left: view[i64], right: view[i64], full: view[f64], shape: view[f64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = ops.len.i64()
    choice: darray[i64] =
        for step in 0..<m |values: darray[i64] = [0 for _ in 0..<m], weight: darray[f64] = [0.0 for _ in 0..<m], skipped: darray[f64] = [0.0 for _ in 0..<m], choice: darray[i64] = [-1 for _ in 0..<m]| -> choice:
            k: i64 = m - 1 - step
            a: i64 = left[k]
            b: i64 = right[k]
            values[k] <- 1 if ops[k] == 0 else 0
            skipped[k] <- shape[k]
            weight[k] <- full[k]
            if a >= 0:
                values[k] <- 1 - values[a]
                skipped[k] <- skipped[k] + skipped[a]
                weight[k] <- weight[k] + weight[a]
            if b >= 0:
                values[k] <- (values[a] * values[b]) if ops[k] == 3 else (1 if values[a] + values[b] > 0 else 0) if ops[k] == 4 else (1 if values[a] != values[b] else 0)
                skipped[k] <- skipped[k] + skipped[b]
                weight[k] <- weight[k] + weight[b]
                for side in 0..<2:
                    kept: i64 = a if side == 0 else b
                    other: i64 = b if side == 0 else a
                    alternative: f64 = full[k] + weight[kept] + skipped[other]
                    if (ops[k] == 3 and values[kept] == 0 or ops[k] == 4 and values[kept] == 1) and alternative <= weight[k]:
                        weight[k] <- alternative
                        choice[k] <- kept
    return
        for k in 0..<m |found: darray[i64] = [1 if i == 0 else 0 for i in 0..<m]| -> found:
            continue if found[k] == 0
            if choice[k] >= 0:
                found[choice[k]] <- 1
            else:
                if left[k] >= 0:
                    found[left[k]] <- 1
                if right[k] >= 0:
                    found[right[k]] <- 1

# Parse arities 0, 1, 2 into two child slots per word; empty means invalid.
def parse_tree(arities: view[i64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = arities.len.i64()
    return [] if m == 0
    result, remaining =
        for k in 0..<m |result: darray[i64] = [-1 for _ in 0..<(2 * m)], parents: darray[i64] = [0 for _ in 0..<m], missing: darray[i64] = [0 for _ in 0..<m], depth: i64 = 0| -> (result, depth):
            return [] if arities[k] < 0 or arities[k] > 2
            if k > 0:
                return [] if depth == 0
                parent: i64 = parents[depth - 1]
                slot: i64 = 2 * parent + (0 if result[2 * parent] < 0 else 1)
                result[slot] <- k
                missing[depth - 1] <- missing[depth - 1] - 1
                depth <- depth - 1 if missing[depth - 1] == 0 else depth
            if arities[k] > 0:
                parents[depth] <- k
                missing[depth] <- arities[k]
                depth += 1
    return result if remaining == 0 else []

# Parse general arities into offsets followed by contiguous child indices.
def parse_tree_generic(arities: view[i64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = arities.len.i64()
    return [] if m == 0
    offsets: darray[i64] = [0 for _ in 0..<(m + 1)]
    for k in 0..<m:
        arity: i64 = arities[k]
        return [] if arity < 0 or arity > m - 1 - offsets[k]
        offsets[k + 1] <- offsets[k] + arity
    return [] if offsets[m] != m - 1
    result, remaining =
        for k in 0..<m |result: darray[i64] = [offsets[i] if i <= m else 0 for i in 0..<(2 * m)], parents: darray[i64] = [0 for _ in 0..<m], missing: darray[i64] = [0 for _ in 0..<m], depth: i64 = 0| -> (result, depth):
            if k > 0:
                return [] if depth == 0
                parent: i64 = parents[depth - 1]
                slot: i64 = m + 1 + offsets[parent] + arities[parent] - missing[depth - 1]
                result[slot] <- k
                missing[depth - 1] <- missing[depth - 1] - 1
                depth <- depth - 1 if missing[depth - 1] == 0 else depth
            if arities[k] > 0:
                parents[depth] <- k
                missing[depth] <- arities[k]
                depth += 1
    return result if remaining == 0 else []

# Keep child slots native between parsing and certificate selection.
def certificate_words(ops: view[i64], full: view[f64], shape: view[f64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    arities: darray[i64] = [0 if ops[k] < 2 else 1 if ops[k] == 2 else 2 for k in 0..<ops.len.i64()]
    children: darray[i64] = parse_tree(arities[0:arities.count])
    return [] if children.count == 0
    left: darray[i64] = [children[2 * k] for k in 0..<ops.len.i64()]
    right: darray[i64] = [children[2 * k + 1] for k in 0..<ops.len.i64()]
    return certificate(ops, left[0:left.count], right[0:right.count], full, shape)

# Sum nonnegative finite row masses into caller-declared groups. Compensated
# additions match Python's floating-point sum on the runtime's float tuples.
def grouped_masses(scores: view[f64], groups: view[i64], entries: i64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = groups.len.i64()
    m: i64 = scores.len.i64() / width
    result, correction =
        for k in 0..<m |result: darray[f64] = [0.0 for _ in 0..<(m * entries)], correction: darray[f64] = [0.0 for _ in 0..<(m * entries)]| -> (result, correction):
            for c in 0..<width |result, correction|:
                cell: i64 = k * entries + groups[c]
                previous: f64 = result[cell]
                weight: f64 = scores[k * width + c]
                total: f64 = previous + weight
                correction[cell] <- correction[cell] + ((previous - total) + weight if previous >= weight else (weight - total) + previous)
                result[cell] <- total
    return [result[i] + correction[i] for i in 0..<(m * entries)]

# Expand a validated partition's group sizes into per-class group IDs.
def partition_group_ids(lengths: view[i64], size: i64) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    return [] if size < 0
    remaining: i64 =
        for group in 0..<lengths.len.i64() |remaining: i64 = size| -> remaining:
            length: i64 = lengths[group]
            return [] if length <= 0 or length > remaining
            remaining <- remaining - length
    return [] if remaining != 0
    result: darray[i64] = [0 for _ in 0..<size]
    offset: darray[i64] = [0]
    for group in 0..<lengths.len.i64():
        length: i64 = lengths[group]
        for i in offset[0]..<(offset[0] + length):
            result[i] <- group
        offset[0] <- offset[0] + length
    return result

# First maximum in each row, matching NumPy's first-NaN behavior as well.
def row_argmax(scores: view[f64], width: i64) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    return [] if width <= 0 or scores.len.i64() % width != 0
    return
        for k in 0..<(scores.len.i64() / width) |result: darray[i64] = [0 for _ in 0..<(scores.len.i64() / width)]| -> result:
            top: i64 =
                for c in 1..<width |top: i64 = 0| -> top:
                    old: f64 = scores[k * width + top]
                    value: f64 = scores[k * width + c]
                    top <- c if old == old and (value != value or value > old) else top
            result[k] <- top

# Argmax within each row's declared group. Strict comparison keeps the first
# class on ties. Group ids are supplied by the caller, not tied to a vocabulary.
def grouped_argmax(scores: view[f64], groups: view[i64], decisions: view[i64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = groups.len.i64()
    return
        for k in 0..<decisions.len.i64() |result: darray[i64] = [-1 for _ in 0..<decisions.len.i64()]| -> result:
            result[k] <-
                for c in 0..<width |chosen: i64 = -1, best: f64 = log(0.0)| -> chosen:
                    continue if groups[c] != decisions[k]
                    if chosen < 0 or scores[k * width + c] > best:
                        chosen <- c
                        best <- scores[k * width + c]

# Allocate a current risk over validated finite nonnegative priorities (23.11).
# Rescale before summing and compensate additions to preserve small weights.
def risk_shares(bound: f64, priorities: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = priorities.len.i64()
    scale: f64 =
        for k in 0..<m |largest: f64 = 0.0| -> largest:
            largest <- priorities[k] if priorities[k] > largest else largest
    weights: darray[f64] = [priorities[k] / scale if scale > 0.0 else 1.0 for k in 0..<m]
    total: f64 =
        for k in 0..<m |total: f64 = 0.0, correction: f64 = 0.0| -> total:
            adjusted: f64 = weights[k] - correction
            next: f64 = total + adjusted
            correction <- (next - total) - adjusted
            total <- next
    result: darray[f64] = [bound * (weights[k] / total) for k in 0..<m]
    positive: bool =
        for k in 0..<m |found: bool = false| -> found:
            found <- true if result[k] > 0.0 else found
    if bound > 0.0 and m > 0 and not positive:
        top: i64 =
            for k in 1..<m |top: i64 = 0| -> top:
                top <- k if weights[k] > weights[top] else top
        result[top] <- bound
    return result

# Log product of the selected sequence, preserving position order.
def sequence_log_weight(log_probs: view[f64], alphabet: view[i64], selected: view[i64]) -> f64 can[Abort.Panic]:
    width: i64 = alphabet.len.i64()
    indexed: bool =
        for c in 0..<width |valid: bool = true| -> valid:
            if alphabet[c] != c:
                valid <- false
                break
    total, failed =
        for k in 0..<selected.len.i64() |total: f64 = 0.0, failed: bool = false| -> (total, failed):
            symbol: i64 = selected[k]
            column: i64 =
                if indexed:
                    symbol if symbol >= 0 and symbol < width else -1
                else:
                    for c in 0..<width |found: i64 = -1| -> found:
                        if alphabet[c] == symbol:
                            found <- c
                            break
            return log(0.0) if column < 0
            reading: f64 = log_probs[k * width + column]
            return log(0.0) if reading == log(0.0)
            if not failed:
                value: f64 = total + reading
                if value > -67108864.0 and value < 67108864.0:
                    total <- value
                else:
                    checked: f64 = partition_log_product(total, reading)
                    if checked != checked:
                        failed <- true
                    else:
                        total <- checked
    return log(-1.0) if failed
    return total

# Validate a complete prefix formula and sum its selected log weights.
# Empty output denotes invalid shape or syntax; [-inf] is zero mass and [nan] is arithmetic failure.
def accepted_log_weight(log_probs: view[f64], alphabet: view[i64], selected: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    m: i64 = selected.len.i64()
    return [] if width == 0 or m == 0 or log_probs.len.i64() != m * width
    pending, total, zero, failed =
        for k in 0..<m |pending: i64 = 1, total: f64 = 0.0, zero: bool = false, failed: bool = false| -> (pending, total, zero, failed):
            arity: i64 = selected[k]
            return [] if pending == 0 or arity < 0 or arity > m - k - 1
            column: i64 =
                for c in 0..<width |found: i64 = -1| -> found:
                    if alphabet[c] == arity:
                        found <- c
                        break
            return [] if column < 0
            pending <- pending - 1 + arity
            reading: f64 = log_probs[k * width + column]
            if reading == log(0.0):
                zero <- true
            else:
                if not zero and not failed:
                    value: f64 = total + reading
                    if value > -67108864.0 and value < 67108864.0:
                        total <- value
                    else:
                        checked: f64 = partition_log_product(total, reading)
                        if checked != checked:
                            failed <- true
                        else:
                            total <- checked
    return [] if pending != 0
    return [log(0.0)] if zero
    return [log(-1.0)] if failed
    return [total]

# Stable temperature-scaled softmax, summed into caller-declared groups.
def calibrated_groups(logits: view[f64], groups: view[i64], entries: i64, temperature: f64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    largest: f64 =
        for k in 0..<logits.len.i64() |largest: f64 = log(0.0)| -> largest:
            largest <- logits[k] if logits[k] > largest else largest
    weights: darray[f64] = [exp((logits[k] - largest) / temperature) for k in 0..<logits.len.i64()]
    total: f64 =
        for k in 0..<weights.count |total: f64 = 0.0| -> total:
            total += weights[k]
    return
        for k in 0..<weights.count |result: darray[f64] = [0.0 for _ in 0..<entries]| -> result:
            result[groups[k]] <- result[groups[k]] + weights[k] / total

# Group probabilities in log space, preserving finite underflowed masses.
def calibrated_log_groups(logits: view[f64], groups: view[i64], entries: i64, temperature: f64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    return [] if logits.len.i64() == 0 or groups.len.i64() != logits.len.i64() or entries <= 0 or temperature <= 0.0
    maxima: darray[f64] = [log(0.0) for _ in 0..<entries]
    state: darray[f64] = [log(0.0), 0.0]
    for k in 0..<logits.len.i64():
        group: i64 = groups[k]
        return [] if group < 0 or group >= entries
        maxima[group] <- logits[k] if logits[k] > maxima[group] else maxima[group]
        state[0] <- logits[k] if logits[k] > state[0] else state[0]
    largest: f64 = state[0]
    return [] if largest == log(0.0)
    totals: darray[f64] = [0.0 for _ in 0..<entries]
    for k in 0..<logits.len.i64():
        group: i64 = groups[k]
        totals[group] <- totals[group] + exp((logits[k] - maxima[group]) / temperature) if maxima[group] != log(0.0) else totals[group]
        state[1] <- state[1] + exp((logits[k] - largest) / temperature)
    return [(maxima[g] - largest) / temperature + log(totals[g]) - log(state[1]) if maxima[g] != log(0.0) else log(0.0) for g in 0..<entries]

def risk_at_anchor(logits: view[f64], groups: view[i64], chosen: i64, temperature: f64, largest: f64) -> f64 can[Memory.Allocate, Abort.Panic]:
    total, outside =
        for i in 0..<logits.len.i64() |total: f64 = 0.0, outside: f64 = 0.0| -> (total, outside):
            weight: f64 = exp((logits[i] - largest) / temperature)
            total += weight
            outside += weight if groups[i] != chosen else 0.0
    result: f64 = outside / total
    return result if result != 0.0
    largest_outside: f64 =
        for i in 0..<logits.len.i64() |largest: f64 = log(0.0)| -> largest:
            largest <- logits[i] if groups[i] != chosen and logits[i] > largest else largest
    return 0.0 if largest_outside == log(0.0)
    scaled: f64 =
        for i in 0..<logits.len.i64() |sum: f64 = 0.0| -> sum:
            sum += exp((logits[i] - largest_outside) / temperature) if groups[i] != chosen else 0.0
    recovered: f64 = exp((largest_outside - largest) / temperature + log(scaled) - log(total))
    return nextafter(0.0, 1.0) if recovered == 0.0 else recovered

# Risk for a caller-selected class in a caller-declared partition.
def calibrated_risk_at(logits: view[f64], groups: view[i64], entries: i64, temperature: f64, top: i64) -> f64 can[Memory.Allocate, Abort.Panic]:
    return log(-1.0) if top < 0 or top >= logits.len.i64() or groups.len.i64() != logits.len.i64()
    largest: f64 =
        for k in 0..<logits.len.i64() |largest: f64 = log(0.0)| -> largest:
            largest <- logits[k] if logits[k] > largest else largest
    return risk_at_anchor(logits, groups, groups[top], temperature, largest)

# Choose from the caller's actual reading and charge its selected group.
def calibrated_risk_for_reading(logits: view[f64], reading: view[f64], groups: view[i64], entries: i64, temperature: f64) -> f64 can[Memory.Allocate, Abort.Panic]:
    return log(-1.0) if logits.len.i64() == 0 or reading.len.i64() != logits.len.i64() or groups.len.i64() != logits.len.i64()
    top: i64 =
        for k in 1..<reading.len.i64() |top: i64 = 0| -> top:
            top <- k if reading[k] > reading[top] else top
    largest: f64 =
        for k in 0..<logits.len.i64() |largest: f64 = log(0.0)| -> largest:
            largest <- logits[k] if logits[k] > largest else largest
    return risk_at_anchor(logits, groups, groups[top], temperature, largest)

# The legacy path selects the first largest individual logit.
def calibrated_risk(logits: view[f64], groups: view[i64], entries: i64, temperature: f64) -> f64 can[Memory.Allocate, Abort.Panic]:
    return log(-1.0) if logits.len.i64() == 0 or groups.len.i64() != logits.len.i64()
    top: i64 =
        for k in 0..<logits.len.i64() |top: i64 = 0| -> top:
            top <- k if logits[k] > logits[top] else top
    return risk_at_anchor(logits, groups, groups[top], temperature, logits[top])

