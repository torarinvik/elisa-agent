# Decoding of prefix-formula arity sequences by the counter automaton (THEORY §21).
#
# The state is the number of subformulas still awaited, starting at 1; a word of arity a
# read while n >= 1 are awaited leaves n - 1 + a, and a sequence is accepted when none
# remain at its end. Before word k only states n <= min(k + 1, m - k) are both reachable
# and completable, so row k of every table holds states 0 ..= min(k + 1, m - k).
#
# The sums run in linear space. Forward row k is stored unscaled and read divided by its
# total c(k), so every step works on a row of total 1 and log Z = Σ log c(k). The backward
# rows are divided by the same totals, so a marginal is
# F(k, n) / c(k) · q(k, a) · B(k + 1, n - 1 + a) / c(k + 1). The most probable sequence is
# found in log space, where it needs only additions.

extern exp(x: f64) -> f64
extern log(x: f64) -> f64

# The log-weight of an unreachable state, and log Z when no sequence is accepted.
const FLOOR: f64 = -1.0e308

def live(k: i64, m: i64) -> i64:
    return k + 1 if k + 1 < m - k else m - k

# `log_probs` holds m rows of one log-probability per entry of `alphabet` (the arities).
# The result is [log Z, decoded arities (m), posterior marginals (m rows)], or [FLOOR] when
# no parseable sequence has positive weight.
def decode(log_probs: view[f64], alphabet: view[i64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = alphabet.len.i64()
    m: i64 = log_probs.len.i64() / width
    return [FLOOR] if m == 0
    offsets: darray[i64] =
        for k in 0..<(m + 1) |offsets: darray[i64] = [0 for _ in 0..<(m + 2)]| -> offsets:
            offsets[k + 1] <- offsets[k] + live(k, m) + 1
    weights: darray[f64] = [exp(log_probs[i]) for i in 0..<(m * width)]
    forward, best, choice, totals, log_z =
        for k in 0..<m |forward: darray[f64] = [1.0 if i == offsets[0] + 1 else 0.0 for i in 0..<offsets[m + 1]], best: darray[f64] = [0.0 if i == offsets[0] + 1 else FLOOR for i in 0..<offsets[m + 1]], choice: darray[i64] = [0 for _ in 0..<offsets[m + 1]], totals: darray[f64] = [1.0 for _ in 0..<(m + 1)], log_z: f64 = 0.0| -> (forward, best, choice, totals, log_z):
            total: f64 = |forward, best, choice|
                next_row: i64 = offsets[k + 1]
                next_top: i64 = live(k + 1, m)
                for n in 1..<(live(k, m) + 1) |forward, best, choice|:
                    here_best: f64 = best[offsets[k] + n]
                    continue if here_best <= FLOOR
                    here: f64 = forward[offsets[k] + n] / totals[k]
                    for j in 0..<width |forward, best, choice|:
                        cell: i64 =
                            target: i64 = n - 1 + alphabet[j]
                            continue if target > next_top
                            next_row + target
                        forward[cell] <- forward[cell] + here * weights[k * width + j]
                        candidate: f64 = here_best + log_probs[k * width + j]
                        choice[cell] <- j if candidate > best[cell] else choice[cell]
                        best[cell] <- candidate if candidate > best[cell] else best[cell]
                for n in 0..<(next_top + 1) |total: f64 = 0.0| -> total:
                    total += forward[next_row + n]
            totals[k + 1] <- 1.0 if total <= 0.0 else total
            log_z <- FLOOR if total <= 0.0 or log_z <= FLOOR else log_z + log(total)
    return [FLOOR] if log_z <= FLOOR or best[offsets[m]] <= FLOOR
    decoded: darray[f64] =
        for step in 0..<m |decoded: darray[f64] = [log_z if i == 0 else 0.0 for i in 0..<(1 + m + m * width)], state: i64 = 0| -> decoded:
            arity: i64 = alphabet[choice[offsets[m - step] + state]]
            decoded[m - step] <- arity.f64()
            state <- state + 1 - arity
    result: darray[f64] =
        for step in 0..<m |result: darray[f64] = decoded, backward: darray[f64] = [1.0 if (i == offsets[m]) else 0.0 for i in 0..<offsets[m + 1]]| -> result:
            k: i64 = m - 1 - step
            here_row: i64 = offsets[k]
            next_row: i64 = offsets[k + 1]
            next_top: i64 = live(k + 1, m)
            for j in 0..<width |result, backward|:
                through_total: f64 = |backward|
                    weight: f64 = weights[k * width + j] / totals[k + 1]
                    for n in 1..<(live(k, m) + 1) |backward, through_total: f64 = 0.0| -> through_total:
                        through: f64 =
                            target: i64 = n - 1 + alphabet[j]
                            continue if target > next_top
                            weight * backward[next_row + target]
                        backward[here_row + n] <- backward[here_row + n] + through
                        through_total += forward[here_row + n] * through
                result[1 + m + k * width + j] <- through_total / totals[k]
    return result

# The banded cursor of THEORY §23.4, rescaled as in §23.7. The caller owns the tables, `width`
# states per row, and keeps rows current around a cursor; these functions recompute rows in
# place. Row `k` holds states `low[k] ..= high[k]`. The sum tables hold linear rows of total 1
# (or all zero) with each row's log scale beside them; the max tables hold log weights.

# For arity `a` at position `i`: the first in-band state `s ≥ 1` whose successor `s − 1 + a` is
# in band at `i + 1`, and how many consecutive such states there are.
def moves(i: i64, a: i64, low: view[i64], high: view[i64]) -> (first: i64, count: i64) can[Abort.Panic]:
    first: i64 =
        lowest: i64 = low[i] if low[i] > 1 else 1
        low[i + 1] + 1 - a if low[i + 1] + 1 - a > lowest else lowest
    last: i64 = high[i] if high[i] < high[i + 1] + 1 - a else high[i + 1] + 1 - a
    return first, (last - first + 1 if last >= first else 0)

# Divide row `row` (states `low ..= high`) by its total and return the total's log, or −∞ for a
# zero row.
def normalize(table: mutable view[f64], row: i64, width: i64, low: i64, high: i64) -> f64 can[Abort.Panic]:
    total: f64 =
        for n in low..<(high + 1) |total: f64 = 0.0| -> total:
            total += table[row * width + n]
    return log(0.0) if total <= 0.0
    for n in low..<(high + 1):
        table[row * width + n] <- table[row * width + n] / total
    return log(total)

# Recompute forward rows `start + 1 ..= stop` from row `start`.
def advance(forward: mutable view[f64], scale: mutable view[f64], forward_max: mutable view[f64], weights: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], width: i64, start: i64, stop: i64) -> i64 can[Abort.Panic]:
    arities: i64 = alphabet.len.i64()
    for i in start..<stop:
        target: i64 = (i + 1) * width
        for n in low[i + 1]..<(high[i + 1] + 1):
            forward[target + n] <- 0.0
            forward_max[target + n] <- log(0.0)
        for j in 0..<arities:
            run: (first: i64, count: i64) = moves(i, alphabet[j], low, high)
            for t in 0..<run.count:
                source: i64 = i * width + run.first + t
                cell: i64 = target + run.first - 1 + alphabet[j] + t
                forward[cell] <- forward[cell] + forward[source] * weights[i * arities + j]
                candidate: f64 = forward_max[source] + log_probs[i * arities + j]
                forward_max[cell] <- candidate if candidate > forward_max[cell] else forward_max[cell]
        scale[i + 1] <- scale[i] + normalize(forward, i + 1, width, low[i + 1], high[i + 1])
    return stop - start

# Recompute backward rows `stop ..= start − 1` from row `start`.
def retreat(backward: mutable view[f64], scale: mutable view[f64], backward_max: mutable view[f64], weights: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], width: i64, start: i64, stop: i64) -> i64 can[Abort.Panic]:
    arities: i64 = alphabet.len.i64()
    for back in 0..<(start - stop):
        i: i64 = start - 1 - back
        for n in low[i]..<(high[i] + 1):
            backward[i * width + n] <- 0.0
            backward_max[i * width + n] <- log(0.0)
        for j in 0..<arities:
            run: (first: i64, count: i64) = moves(i, alphabet[j], low, high)
            for t in 0..<run.count:
                cell: i64 = i * width + run.first + t
                source: i64 = (i + 1) * width + run.first - 1 + alphabet[j] + t
                backward[cell] <- backward[cell] + backward[source] * weights[i * arities + j]
                candidate: f64 = backward_max[source] + log_probs[i * arities + j]
                backward_max[cell] <- candidate if candidate > backward_max[cell] else backward_max[cell]
        scale[i] <- scale[i + 1] + normalize(backward, i, width, low[i], high[i])
    return start - stop

# [log Z, best log weight] with word `k`'s weights replaced by `row` (linear) and `log_row`,
# from forward row `k` and backward row `k + 1`.
def scores(forward: view[f64], forward_scale: view[f64], forward_max: view[f64], backward: view[f64], backward_scale: view[f64], backward_max: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], width: i64, k: i64, row: view[f64], log_row: view[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    total, log_x =
        for j in 0..<alphabet.len.i64() |total: f64 = 0.0, log_x: f64 = log(0.0)| -> (total, log_x):
            run: (first: i64, count: i64) = moves(k, alphabet[j], low, high)
            for t in 0..<run.count |total, log_x|:
                here: i64 = k * width + run.first + t
                next: i64 = (k + 1) * width + run.first - 1 + alphabet[j] + t
                total += forward[here] * row[j] * backward[next]
                candidate: f64 = forward_max[here] + backward_max[next] + log_row[j]
                log_x <- candidate if candidate > log_x else log_x
    return [log(0.0) if total <= 0.0 else forward_scale[k] + backward_scale[k + 1] + log(total), log_x]

# [best log weight, its arities (m)], with forward max row `k` and backward max row `k + 1`
# current (THEORY §23.4, Theorem 23.10): the best state and arity at word `k`, then the best
# prefix traced back through the forward max rows and the best suffix forward through the
# backward max rows.
def trace(forward_max: view[f64], backward_max: view[f64], log_probs: view[f64], alphabet: view[i64], low: view[i64], high: view[i64], width: i64, k: i64) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    arities: i64 = alphabet.len.i64()
    m: i64 = low.len.i64() - 1
    log_x, state, choice =
        for j in 0..<arities |log_x: f64 = log(0.0), state: i64 = 0, choice: i64 = 0| -> (log_x, state, choice):
            run: (first: i64, count: i64) = moves(k, alphabet[j], low, high)
            for t in 0..<run.count |log_x, state, choice|:
                n: i64 = run.first + t
                candidate: f64 = forward_max[k * width + n] + backward_max[(k + 1) * width + n - 1 + alphabet[j]] + log_probs[k * arities + j]
                if candidate > log_x:
                    log_x <- candidate
                    state <- n
                    choice <- j
    result: darray[f64] = [0.0 for i in 0..<(m + 1)]
    result[0] <- log_x
    result[1 + k] <- alphabet[choice].f64()
    for back in 0..<k |before: i64 = state|:
        i: i64 = k - 1 - back
        best, source, arity =
            for j in 0..<arities |best: f64 = log(0.0), source: i64 = 1, arity: i64 = 0| -> (best, source, arity):
                n: i64 = before + 1 - alphabet[j]
                continue if n < 1 or n < low[i] or n > high[i]
                candidate: f64 = forward_max[i * width + n] + log_probs[i * arities + j]
                if candidate > best:
                    best <- candidate
                    source <- n
                    arity <- alphabet[j]
        result[1 + i] <- arity.f64()
        before <- source
    for i in (k + 1)..<m |after: i64 = state - 1 + alphabet[choice]|:
        best, target, arity =
            for j in 0..<arities |best: f64 = log(0.0), target: i64 = 0, arity: i64 = 0| -> (best, target, arity):
                n: i64 = after - 1 + alphabet[j]
                continue if after < 1 or n < low[i + 1] or n > high[i + 1]
                candidate: f64 = log_probs[i * arities + j] + backward_max[(i + 1) * width + n]
                if candidate > best:
                    best <- candidate
                    target <- n
                    arity <- alphabet[j]
        result[1 + i] <- arity.f64()
        after <- target
    return result

# Least-risk certificate on an already parsed prefix tree. Opcodes follow the
# formula vocabulary: true, false, not, and, or, xor. Ties prefer the right child.
def certificate(ops: view[i64], left: view[i64], right: view[i64], full: view[f64], shape: view[f64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = ops.len.i64()
    choice: darray[i64] =
        for step in 0..<m |values: darray[i64] = [0 for _ in 0..<m], weight: darray[f64] = [0.0 for _ in 0..<m], skipped: darray[f64] = [0.0 for _ in 0..<m], choice: darray[i64] = [-1 for _ in 0..<m]| -> choice:
            k: i64 = m - 1 - step
            a: i64 = left[k]
            b: i64 = right[k]
            values[k] <- 1 if ops[k] == 0 else 0
            skipped[k] <- shape[k]
            weight[k] <- full[k]
            if a >= 0:
                values[k] <- 1 - values[a]
                skipped[k] <- skipped[k] + skipped[a]
                weight[k] <- weight[k] + weight[a]
            if b >= 0:
                values[k] <- (values[a] * values[b]) if ops[k] == 3 else (1 if values[a] + values[b] > 0 else 0) if ops[k] == 4 else (1 if values[a] != values[b] else 0)
                skipped[k] <- skipped[k] + skipped[b]
                weight[k] <- weight[k] + weight[b]
                for side in 0..<2:
                    kept: i64 = a if side == 0 else b
                    other: i64 = b if side == 0 else a
                    alternative: f64 = full[k] + weight[kept] + skipped[other]
                    if (ops[k] == 3 and values[kept] == 0 or ops[k] == 4 and values[kept] == 1) and alternative <= weight[k]:
                        weight[k] <- alternative
                        choice[k] <- kept
    return
        for k in 0..<m |found: darray[i64] = [1 if i == 0 else 0 for i in 0..<m]| -> found:
            continue if found[k] == 0
            if choice[k] >= 0:
                found[choice[k]] <- 1
            else:
                if left[k] >= 0:
                    found[left[k]] <- 1
                if right[k] >= 0:
                    found[right[k]] <- 1

# Parse arities 0, 1, 2 into two child slots per word; empty means invalid.
def parse_tree(arities: view[i64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    m: i64 = arities.len.i64()
    return [] if m == 0
    result, remaining =
        for k in 0..<m |result: darray[i64] = [-1 for _ in 0..<(2 * m)], parents: darray[i64] = [0 for _ in 0..<m], missing: darray[i64] = [0 for _ in 0..<m], depth: i64 = 0| -> (result, depth):
            return [] if arities[k] < 0 or arities[k] > 2
            if k > 0:
                return [] if depth == 0
                parent: i64 = parents[depth - 1]
                slot: i64 = 2 * parent + (0 if result[2 * parent] < 0 else 1)
                result[slot] <- k
                missing[depth - 1] <- missing[depth - 1] - 1
                depth <- depth - 1 if missing[depth - 1] == 0 else depth
            if arities[k] > 0:
                parents[depth] <- k
                missing[depth] <- arities[k]
                depth += 1
    return result if remaining == 0 else []

# Keep child slots native between parsing and certificate selection.
def certificate_words(ops: view[i64], full: view[f64], shape: view[f64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    arities: darray[i64] = [0 if ops[k] < 2 else 1 if ops[k] == 2 else 2 for k in 0..<ops.len.i64()]
    children: darray[i64] = parse_tree(arities[0:arities.count])
    return [] if children.count == 0
    left: darray[i64] = [children[2 * k] for k in 0..<ops.len.i64()]
    right: darray[i64] = [children[2 * k + 1] for k in 0..<ops.len.i64()]
    return certificate(ops, left[0:left.count], right[0:right.count], full, shape)

# Argmax within each row's declared group. Strict comparison keeps the first
# class on ties. Group ids are supplied by the caller, not tied to a vocabulary.
def grouped_argmax(scores: view[f64], groups: view[i64], decisions: view[i64]) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    width: i64 = groups.len.i64()
    return
        for k in 0..<decisions.len.i64() |result: darray[i64] = [-1 for _ in 0..<decisions.len.i64()]| -> result:
            result[k] <-
                for c in 0..<width |chosen: i64 = -1, best: f64 = log(0.0)| -> chosen:
                    continue if groups[c] != decisions[k]
                    if chosen < 0 or scores[k * width + c] > best:
                        chosen <- c
                        best <- scores[k * width + c]

export pymodule decoding:
    fn decode
    fn advance
    fn retreat
    fn scores
    fn trace
    fn certificate
    fn parse_tree
    fn certificate_words
    fn grouped_argmax
